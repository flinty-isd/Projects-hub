{
  "$comment": "Data schema for the Enterprise PMO hub, all on one PMO site. Applied by provisioning/Provision-PMOHub.ps1. Source of truth reviewed in PRs; tools/validate_flows.py and tools/validate_dashboard.py check every column the flows and views use against it. flowManaged columns are hidden from the new and edit forms; hidden columns are also left out of views.",
  "lists": [
    {
      "listTitle": "PMO Workstreams",
      "url": "Lists/PMOWorkstreams",
      "template": "GenericList",
      "listDescription": "One row per portfolio workstream. Every RAID item, action, change request and document points at one. Flow 02 loops over the active rows. The RAG columns feed the Power BI scorecard.",
      "fields": [
        {
          "internalName": "WorkstreamCode",
          "displayName": "Workstream code",
          "type": "Text",
          "required": true,
          "notes": "Short code used in snapshot keys, e.g. ALPHA. Unique."
        },
        {
          "internalName": "Sponsor",
          "displayName": "Sponsor",
          "type": "Person",
          "required": false
        },
        {
          "internalName": "WorkstreamLead",
          "displayName": "Workstream lead",
          "type": "Person",
          "required": false
        },
        {
          "internalName": "Active",
          "displayName": "Active",
          "type": "Boolean",
          "required": false,
          "default": "1",
          "indexed": true,
          "notes": "Only active workstreams get weekly snapshots and early warnings."
        },
        {
          "internalName": "OverallRAG",
          "displayName": "Overall RAG",
          "type": "Choice",
          "required": false,
          "choices": [
            "Red",
            "Amber",
            "Green"
          ]
        },
        {
          "internalName": "ScheduleRAG",
          "displayName": "Schedule RAG",
          "type": "Choice",
          "required": false,
          "choices": [
            "Red",
            "Amber",
            "Green"
          ]
        },
        {
          "internalName": "BudgetRAG",
          "displayName": "Budget RAG",
          "type": "Choice",
          "required": false,
          "choices": [
            "Red",
            "Amber",
            "Green"
          ]
        },
        {
          "internalName": "ScopeRAG",
          "displayName": "Scope RAG",
          "type": "Choice",
          "required": false,
          "choices": [
            "Red",
            "Amber",
            "Green"
          ]
        },
        {
          "internalName": "StatusSummary",
          "displayName": "Status summary",
          "type": "Note",
          "required": false
        }
      ]
    },
    {
      "listTitle": "Master RAID Log",
      "url": "Lists/MasterRAIDLog",
      "template": "GenericList",
      "listDescription": "Risks, assumptions, issues and dependencies for every workstream. Items flagged Escalated to Executive Board show on the hub and in the daily digest when overdue.",
      "fields": [
        {
          "internalName": "RAIDType",
          "displayName": "Type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Risk",
            "Assumption",
            "Issue",
            "Dependency"
          ],
          "default": "Risk",
          "indexed": true
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": true,
          "indexed": true,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "Description",
          "displayName": "Description",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "RAGRating",
          "displayName": "RAG rating",
          "type": "Choice",
          "required": false,
          "choices": [
            "Red",
            "Amber",
            "Green"
          ]
        },
        {
          "internalName": "Owner",
          "displayName": "Owner",
          "type": "Person",
          "required": false
        },
        {
          "internalName": "Status",
          "displayName": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Open",
            "In progress",
            "Closed"
          ],
          "default": "Open",
          "indexed": true
        },
        {
          "internalName": "EscalatedToExecutiveBoard",
          "displayName": "Escalated to Executive Board",
          "type": "Boolean",
          "required": false,
          "default": "0",
          "indexed": true,
          "flowManaged": true,
          "notes": "Set by flow 05 when the Head of PMO approves an escalation request. Not on the forms; the PMO can still set it in grid view for an escalation agreed outside the flow."
        },
        {
          "internalName": "EscalationRequested",
          "displayName": "Request Executive Board escalation",
          "type": "Boolean",
          "required": false,
          "default": "0",
          "notes": "Tick to ask the Head of PMO to put this item in front of the Executive Board (flow 05). Cleared again if the request is declined or not decided, so it can be ticked again."
        },
        {
          "internalName": "EscalationJustification",
          "displayName": "Why it needs the Board",
          "type": "Note",
          "required": false,
          "notes": "What the Board must decide or unblock, and by when. Shown in the approval request."
        },
        {
          "internalName": "EscalationStatus",
          "displayName": "Escalation status",
          "type": "Choice",
          "required": false,
          "choices": [
            "Not requested",
            "Requested",
            "Approved",
            "Declined",
            "Not decided"
          ],
          "default": "Not requested",
          "flowManaged": true,
          "indexed": true,
          "notes": "Written by flow 05 only."
        },
        {
          "internalName": "EscalationDecisionNote",
          "displayName": "Escalation decision",
          "type": "Note",
          "required": false,
          "flowManaged": true,
          "notes": "Written by flow 05: who decided, when, and their comments."
        },
        {
          "internalName": "TargetResolutionDate",
          "displayName": "Target resolution date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "indexed": true
        },
        {
          "internalName": "Mitigation",
          "displayName": "Mitigation / resolution plan",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "ClosedDate",
          "displayName": "Closed on",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "flowManaged": true,
          "indexed": true,
          "notes": "Written by the churn tracker flow when Status changes to Closed. Flow 02 counts closures from it."
        },
        {
          "internalName": "DatePushCount",
          "displayName": "Date pushes",
          "type": "Number",
          "required": false,
          "flowManaged": true,
          "default": "0",
          "notes": "Written by the churn tracker flow: how many times TargetResolutionDate has been moved later. Never reset."
        },
        {
          "internalName": "OriginalTargetDate",
          "displayName": "Original baseline date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "flowManaged": true,
          "notes": "Written by the churn tracker flow: the first TargetResolutionDate the item ever had. Users can't see it on the forms; the Date Push Log is the audit trail if it is edited in the grid."
        },
        {
          "internalName": "LastPushNote",
          "displayName": "Last date push",
          "type": "Note",
          "required": false,
          "flowManaged": true,
          "notes": "Written by the churn tracker flow: old date, new date, days moved, who and when."
        },
        {
          "internalName": "TrackedDueDate",
          "displayName": "Tracked date (flow)",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "hidden": true,
          "notes": "Flow-only. The TargetResolutionDate value the churn tracker last saw, as raw text ('none' when empty). The trigger condition compares it with TargetResolutionDate, which stops the flow re-triggering on its own update. Leave blank when loading."
        },
        {
          "internalName": "TrackedStatus",
          "displayName": "Tracked status (flow)",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "hidden": true,
          "notes": "Flow-only. The Status the churn tracker last saw. Leave blank when loading."
        }
      ]
    },
    {
      "listTitle": "Action and Decision Tracker",
      "url": "Lists/ActionDecisionTracker",
      "template": "GenericList",
      "listDescription": "Actions and decisions from governance forums. Decisions Required by the Executive Board show on the hub; overdue Executive Board items go in the daily digest.",
      "fields": [
        {
          "internalName": "Category",
          "displayName": "Category",
          "type": "Choice",
          "required": true,
          "choices": [
            "Action",
            "Decision Required",
            "Decision Made"
          ],
          "default": "Action",
          "indexed": true
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": true,
          "indexed": true,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "AssignedOwner",
          "displayName": "Assigned owner",
          "type": "Person",
          "required": false
        },
        {
          "internalName": "DecisionForum",
          "displayName": "Decision forum",
          "type": "Choice",
          "required": true,
          "choices": [
            "Executive Board",
            "Steering Committee",
            "PMO",
            "Workstream"
          ],
          "default": "Workstream",
          "indexed": true,
          "notes": "Who owns the action or decision. Replaces the blueprint's 'DecisionOwner eq [Current User / Executive Board]', which a view can't express."
        },
        {
          "internalName": "Status",
          "displayName": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Open",
            "In progress",
            "Blocked",
            "Completed"
          ],
          "default": "Open",
          "indexed": true
        },
        {
          "internalName": "DueDate",
          "displayName": "Due date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "indexed": true
        },
        {
          "internalName": "RelatedRAIDId",
          "displayName": "Related RAID item ID",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "DecisionOutcome",
          "displayName": "Decision / outcome",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "CompletedDate",
          "displayName": "Completed on",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "flowManaged": true,
          "indexed": true,
          "notes": "Written by the churn tracker flow when Status changes to Completed. Flow 02 counts closures from it."
        },
        {
          "internalName": "DatePushCount",
          "displayName": "Date pushes",
          "type": "Number",
          "required": false,
          "flowManaged": true,
          "default": "0",
          "notes": "Written by the churn tracker flow: how many times DueDate has been moved later. Never reset."
        },
        {
          "internalName": "OriginalDueDate",
          "displayName": "Original baseline date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly",
          "flowManaged": true,
          "notes": "Written by the churn tracker flow: the first DueDate the item ever had. Users can't see it on the forms; the Date Push Log is the audit trail if it is edited in the grid."
        },
        {
          "internalName": "LastPushNote",
          "displayName": "Last date push",
          "type": "Note",
          "required": false,
          "flowManaged": true,
          "notes": "Written by the churn tracker flow: old date, new date, days moved, who and when."
        },
        {
          "internalName": "TrackedDueDate",
          "displayName": "Tracked date (flow)",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "hidden": true,
          "notes": "Flow-only. The DueDate value the churn tracker last saw, as raw text ('none' when empty). The trigger condition compares it with DueDate, which stops the flow re-triggering on its own update. Leave blank when loading."
        },
        {
          "internalName": "TrackedStatus",
          "displayName": "Tracked status (flow)",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "hidden": true,
          "notes": "Flow-only. The Status the churn tracker last saw. Leave blank when loading."
        }
      ]
    },
    {
      "listTitle": "Change Requests",
      "url": "Lists/ChangeRequests",
      "template": "GenericList",
      "listDescription": "Baseline change control: scope, budget or timeline variance requests. Target of the hub's Submit Change Request link. Flow 04 runs the PMO review and, over tolerance, the Steering Committee decision.",
      "fields": [
        {
          "internalName": "CRReference",
          "displayName": "CR reference",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "notes": "Allocated by flow 04 as CR-nnn from the item ID when left blank."
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": true,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "ChangeType",
          "displayName": "Change type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Scope",
            "Budget",
            "Timeline",
            "Multiple"
          ]
        },
        {
          "internalName": "Description",
          "displayName": "Change requested",
          "type": "Note",
          "required": true
        },
        {
          "internalName": "Justification",
          "displayName": "Justification",
          "type": "Note",
          "required": true
        },
        {
          "internalName": "ImpactSummary",
          "displayName": "Impact on baseline",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "BudgetImpact",
          "displayName": "Budget impact (GBP)",
          "type": "Number",
          "required": false,
          "notes": "Net change to the approved budget; negative for a saving. Over CRBudgetTolerance goes to the Steering Committee."
        },
        {
          "internalName": "ScheduleImpactDays",
          "displayName": "Schedule impact (days)",
          "type": "Number",
          "required": false,
          "notes": "Days the baseline end date moves. Over CRScheduleToleranceDays goes to the Steering Committee."
        },
        {
          "internalName": "RequestedBy",
          "displayName": "Requested by",
          "type": "Person",
          "required": false,
          "notes": "Who gets the outcome email. Blank means the person who created the item."
        },
        {
          "internalName": "Status",
          "displayName": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Submitted",
            "Under review - PMO",
            "Under review - Steering Committee",
            "Approved",
            "Rejected",
            "Returned to requester",
            "Decision overdue",
            "Withdrawn"
          ],
          "default": "Submitted",
          "hideOnNewForm": true,
          "notes": "Set by flow 04. The requester can set Withdrawn. The PMO sets the outcome by hand for a Decision overdue request decided outside the flow."
        },
        {
          "internalName": "SteeringCommitteeDate",
          "displayName": "Steering Committee date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly"
        },
        {
          "internalName": "DecisionRoute",
          "displayName": "Decision route",
          "type": "Text",
          "required": false,
          "flowManaged": true,
          "notes": "Written by flow 04: PMO (within tolerance) or Steering Committee."
        },
        {
          "internalName": "DecidedBy",
          "displayName": "Decided by",
          "type": "Text",
          "required": false,
          "flowManaged": true
        },
        {
          "internalName": "DecisionDate",
          "displayName": "Decision date",
          "type": "DateTime",
          "required": false,
          "flowManaged": true
        },
        {
          "internalName": "DecisionNote",
          "displayName": "Decision note",
          "type": "Note",
          "required": false,
          "flowManaged": true,
          "notes": "Written by flow 04: approvers' comments at each stage."
        }
      ]
    },
    {
      "listTitle": "PMO Governance Calendar",
      "url": "Lists/GovernanceCalendar",
      "template": "Events",
      "builtinColumns": [
        "EventDate",
        "EndDate",
        "Location",
        "Description",
        "fAllDayEvent",
        "Category"
      ],
      "listDescription": "Steering Committee gates, PMO working groups and Scope Control Board meetings, with submission deadlines. Created from the Events template so the Events web part can also use it.",
      "fields": [
        {
          "internalName": "GovernanceForum",
          "displayName": "Governance forum",
          "type": "Choice",
          "required": true,
          "choices": [
            "Steering Committee Gate",
            "PMO Working Group",
            "Scope Control Board",
            "Other"
          ]
        },
        {
          "internalName": "SubmissionDeadline",
          "displayName": "Submission deadline",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly"
        }
      ]
    },
    {
      "listTitle": "Portfolio Document Repository",
      "url": "PortfolioDocuments",
      "template": "DocumentLibrary",
      "builtinColumns": [
        "LinkFilename",
        "FileLeafRef",
        "DocIcon"
      ],
      "listDescription": "Approved charters, PIDs, stage-gate submissions and closure reports.",
      "fields": [
        {
          "internalName": "DocumentType",
          "displayName": "Document type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Project Initiation Document (PID)",
            "Approved Baseline Charter",
            "Stage Gate Submission",
            "Closure Report",
            "Other"
          ],
          "indexed": true
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": false,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "ApprovalStatus",
          "displayName": "Approval status",
          "type": "Choice",
          "required": false,
          "choices": [
            "Draft",
            "Approved",
            "Superseded"
          ],
          "default": "Draft"
        }
      ]
    },
    {
      "listTitle": "Governance Framework and SOPs",
      "url": "GovernanceFramework",
      "template": "DocumentLibrary",
      "builtinColumns": [
        "LinkFilename",
        "FileLeafRef",
        "DocIcon"
      ],
      "listDescription": "Delivery frameworks, stage-gate guidelines, PMO templates and standard operating procedures.",
      "fields": [
        {
          "internalName": "FrameworkArea",
          "displayName": "Framework area",
          "type": "Choice",
          "required": false,
          "choices": [
            "Delivery framework",
            "Stage gate",
            "Template",
            "Standard operating procedure"
          ]
        }
      ]
    },
    {
      "listTitle": "PMO Trend Snapshots",
      "url": "Lists/PMOTrendSnapshots",
      "template": "GenericList",
      "listDescription": "Written by flow 02 only: one row per active workstream per week with the early-warning metrics. Read by Power BI for trends. Append-only; don't edit.",
      "fields": [
        {
          "internalName": "SnapshotDate",
          "displayName": "Snapshot date",
          "type": "DateTime",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": true,
          "indexed": true,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "OpenRedCount",
          "displayName": "Open Red items",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "OpenAmberCount",
          "displayName": "Open Amber items",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "NewRisksLast7Days",
          "displayName": "New risks/issues (7 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ClosedRisksLast7Days",
          "displayName": "Closed risks/issues (7 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "NetRiskVelocity",
          "displayName": "Net risk velocity",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ActionsDueNext10Days",
          "displayName": "Actions due next 10 days",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ActionsClosedLast7Days",
          "displayName": "Actions closed (7 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ActionsOpenedLast7Days",
          "displayName": "Actions opened (7 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "BurnDownRatio",
          "displayName": "Action burn-down ratio",
          "type": "Number",
          "required": false,
          "decimals": 2
        },
        {
          "internalName": "DateChurnCount14d",
          "displayName": "Date pushes (14 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ChurnAlerts14d",
          "displayName": "Pushes at churn threshold (14 days)",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "EarlyWarningScore",
          "displayName": "Early warning score",
          "type": "Number",
          "required": false,
          "notes": "0 to 3: one point for each of RVEL-HIGH, ABD-SLO and CHURN-CRIT."
        },
        {
          "internalName": "WarningCodes",
          "displayName": "Warning codes",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "WarningReason",
          "displayName": "Warning reason",
          "type": "Note",
          "required": false
        },
        {
          "internalName": "AdvisoryPosted",
          "displayName": "Advisory posted to Teams",
          "type": "Boolean",
          "required": false,
          "default": "0"
        }
      ]
    },
    {
      "listTitle": "PMO Date Push Log",
      "url": "Lists/PMODatePushLog",
      "template": "GenericList",
      "listDescription": "Written by flows 03a and 03b only: one row each time a RAID target date or action due date is moved later. Append-only audit trail; flow 02 reads it for churn.",
      "fields": [
        {
          "internalName": "SourceList",
          "displayName": "Source list",
          "type": "Choice",
          "required": true,
          "choices": [
            "Master RAID Log",
            "Action and Decision Tracker"
          ],
          "indexed": true
        },
        {
          "internalName": "SourceItemId",
          "displayName": "Source item ID",
          "type": "Number",
          "required": true,
          "indexed": true
        },
        {
          "internalName": "Workstream",
          "displayName": "Workstream",
          "type": "Lookup",
          "required": false,
          "lookupList": "PMO Workstreams",
          "lookupField": "Title"
        },
        {
          "internalName": "PreviousDate",
          "displayName": "Previous date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly"
        },
        {
          "internalName": "NewDate",
          "displayName": "New date",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly"
        },
        {
          "internalName": "DaysPushed",
          "displayName": "Days pushed",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "PushedBy",
          "displayName": "Pushed by",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "PushesInWindow",
          "displayName": "Pushes of this item in window",
          "type": "Number",
          "required": false,
          "notes": "This push plus the item's earlier pushes in the last ChurnWindowDays (default 14). Flow 02 raises CHURN-CRIT when it reaches ChurnThreshold."
        }
      ]
    },
    {
      "listTitle": "PMO Digest History",
      "url": "Lists/PMODigestHistory",
      "template": "GenericList",
      "listDescription": "Written by flow 01 only: one row per daily digest (Title digest|yyyy-MM-dd). The row is claimed before posting so a re-run the same day posts nothing. Delete a Failed row to let a re-run post.",
      "fields": [
        {
          "internalName": "DigestDate",
          "displayName": "Digest date",
          "type": "DateTime",
          "required": true
        },
        {
          "internalName": "Status",
          "displayName": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Posting",
            "Posted",
            "Failed"
          ]
        },
        {
          "internalName": "EscalationsCount",
          "displayName": "Overdue escalations",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "ActionsCount",
          "displayName": "Overdue board actions",
          "type": "Number",
          "required": false
        },
        {
          "internalName": "FlowRunId",
