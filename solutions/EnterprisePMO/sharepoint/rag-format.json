{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "$comment": "RAG status pill for Choice columns with Red, Amber, Green (RAGRating, OverallRAG, ScheduleRAG, BudgetRAG, ScopeRAG). The word always shows; colour never carries the meaning alone. Fixed colours rather than theme tokens, as in the governance status badges.",
  "elmType": "div",
  "style": {
    "display": "inline-flex",
    "align-items": "center",
    "padding": "2px 10px",
    "border-radius": "12px",
    "font-weight": "600",
    "font-size": "11px",
    "letter-spacing": "0.5px",
    "text-transform": "uppercase",
    "background-color": "=if(@currentField == 'Red', '#fee2e2', if(@currentField == 'Amber', '#fef3c7', if(@currentField == 'Green', '#dcfce7', '#f3f4f6')))",
    "color": "=if(@currentField == 'Red', '#7f1d1d', if(@currentField == 'Amber', '#78350f', if(@currentField == 'Green', '#14532d', '#374151')))",
    "border": "=if(@currentField == 'Red', '1px solid #b91c1c', if(@currentField == 'Amber', '1px solid #b45309', if(@currentField == 'Green', '1px solid #15803d', '1px solid #9ca3af')))"
  },
  "children": [
    {
      "elmType": "span",
      "style": {
        "width": "7px",
        "height": "7px",
        "border-radius": "50%",
        "margin-right": "6px",
        "background-color": "=if(@currentField == 'Red', '#b91c1c', if(@currentField == 'Amber', '#b45309', if(@currentField == 'Green', '#15803d', '#9ca3af')))"
      }
    },
    {
      "elmType": "span",
      "txtContent": "=if(@currentField == '', 'Unassigned', @currentField)"
    }
  ]
}
