{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "Provision governed SharePoint sites",
  "description": "Triggers on each new 'Site Requests' item. Requires two different, enabled, internal named owners and Owners/Members security groups, gets Project Manager approval (plus InfoSec when external sharing or Highly Confidential is requested), creates the team site, runs the Set-SiteGovernanceBaseline runbook (groups, sharing off by default, sensitivity label, no custom scripts), and records the site in the Site Register for 90-day access reviews.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    },
    "shared_approvals": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
    },
    "shared_webcontents": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
    },
    "shared_azureautomation": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_azureautomation"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "GovernanceSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{governance-site}"
    },
    "TenantRootUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com"
    },
    "ProjectManagerEmail": {
      "type": "String",
      "defaultValue": "{it-project-manager}@{domain}"
    },
    "InfoSecApproverEmail": {
      "type": "String",
      "defaultValue": "{security-and-architecture}@{domain}"
    },
    "SponsorEmail": {
      "type": "String",
      "defaultValue": "{project-sponsor}@{domain}"
    },
    "PortfolioManagerEmail": {
      "type": "String",
      "defaultValue": "{it-portfolio-manager}@{domain}"
    },
    "ITOpsOwnerEmail": {
      "type": "String",
      "defaultValue": "{it-operations-owner}@{domain}"
    },
    "BusinessAnalystEmail": {
      "type": "String",
      "defaultValue": "{business-analyst}@{domain}"
    },
    "ServiceDeskEmail": {
      "type": "String",
      "defaultValue": "{service-desk}@{domain}"
    },
    "AutomationSubscriptionId": {
      "type": "String",
      "defaultValue": "{subscription-id}"
    },
    "AutomationResourceGroup": {
      "type": "String",
      "defaultValue": "{resource-group}"
    },
    "AutomationAccountName": {
      "type": "String",
      "defaultValue": "{automation-account}"
    }
  },
  "triggers": {
    "When_a_site_request_is_created": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnNewItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('GovernanceSiteUrl')",
          "table": "Site Requests"
        }
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      },
      "splitOn": "@triggerOutputs()?['body/value']"
    }
  },
  "actions": {
    "Initialize_SecurityOutcome": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SecurityOutcome",
            "type": "string",
            "value": "Not required"
          }
        ]
      },
      "runAfter": {}
    },
    "Get_primary_owner": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_webcontents",
          "operationId": "InvokeHttp",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
        },
        "parameters": {
          "request/method": "GET",
          "request/url": "https://graph.microsoft.com/v1.0/users/@{triggerBody()?['PrimaryOwner']?['Email']}?$select=accountEnabled,userType,assignedLicenses"
        }
      },
      "runAfter": {
        "Initialize_SecurityOutcome": [
          "Succeeded"
        ]
      }
    },
    "Get_secondary_owner": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_webcontents",
          "operationId": "InvokeHttp",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
        },
        "parameters": {
          "request/method": "GET",
          "request/url": "https://graph.microsoft.com/v1.0/users/@{triggerBody()?['SecondaryOwner']?['Email']}?$select=accountEnabled,userType,assignedLicenses"
        }
      },
      "runAfter": {
        "Get_primary_owner": [
          "Succeeded",
          "Failed"
        ]
      }
    },
    "Condition_RequestValid": {
      "type": "If",
      "expression": {
        "and": [
          {
            "not": {
              "equals": [
                "@triggerBody()?['PrimaryOwner']?['Email']",
                null
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@triggerBody()?['SecondaryOwner']?['Email']",
                null
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@toLower(triggerBody()?['PrimaryOwner']?['Email'])",
                "@toLower(triggerBody()?['SecondaryOwner']?['Email'])"
              ]
            }
          },
          {
            "equals": [
              "@body('Get_primary_owner')?['accountEnabled']",
              true
            ]
          },
          {
            "equals": [
              "@body('Get_secondary_owner')?['accountEnabled']",
              true
            ]
          },
          {
            "equals": [
              "@body('Get_primary_owner')?['userType']",
              "Member"
            ]
          },
          {
            "equals": [
              "@body('Get_secondary_owner')?['userType']",
              "Member"
            ]
          },
          {
            "not": {
              "equals": [
                "@triggerBody()?['MembersGroupId']",
                null
              ]
            }
          },
          {
            "not": {
              "equals": [
                "@triggerBody()?['OwnersGroupId']",
                null
              ]
            }
          }
        ]
      },
      "actions": {
        "Approval_PM": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
            },
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "@{concat('New SharePoint site: ', triggerBody()?['Title'])}",
              "WebhookApprovalCreationInput/assignedTo": "@parameters('ProjectManagerEmail')",
              "WebhookApprovalCreationInput/details": "@{concat('Site: ', triggerBody()?['Title'], ' (', concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias']), ')', decodeUriComponent('%0A'), 'Department: ', triggerBody()?['Department'], decodeUriComponent('%0A'), 'Wave: ', triggerBody()?['Wave'], decodeUriComponent('%0A'), 'Primary owner: ', triggerBody()?['PrimaryOwner']?['Email'], decodeUriComponent('%0A'), 'Secondary owner: ', triggerBody()?['SecondaryOwner']?['Email'], decodeUriComponent('%0A'), 'Sensitivity: ', triggerBody()?['Sensitivity']?['Value'], decodeUriComponent('%0A'), 'External sharing: ', if(equals(triggerBody()?['ExternalSharingRequired'], true), 'Requested', 'Off'))}",
              "WebhookApprovalCreationInput/itemLink": "@triggerBody()?['{Link}']",
              "WebhookApprovalCreationInput/itemLinkDescription": "Open the request",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            }
          },
          "runAfter": {}
        },
        "Condition_PM_approved": {
          "type": "If",
          "expression": {
            "equals": [
              "@outputs('Approval_PM')?['body/outcome']",
              "Approve"
            ]
          },
          "actions": {
            "Condition_NeedsInfoSec": {
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@triggerBody()?['ExternalSharingRequired']",
                      true
                    ]
                  },
                  {
                    "equals": [
                      "@triggerBody()?['Sensitivity']?['Value']",
                      "Highly Confidential"
                    ]
                  }
                ]
              },
              "actions": {
                "Approval_InfoSec": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_approvals",
                      "operationId": "StartAndWaitForAnApproval",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
                    },
                    "parameters": {
                      "approvalType": "Basic",
                      "WebhookApprovalCreationInput/title": "@{concat('Security review - new site: ', triggerBody()?['Title'])}",
                      "WebhookApprovalCreationInput/assignedTo": "@parameters('InfoSecApproverEmail')",
                      "WebhookApprovalCreationInput/details": "@{concat('Site: ', triggerBody()?['Title'], ' (', concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias']), ')', decodeUriComponent('%0A'), 'Department: ', triggerBody()?['Department'], decodeUriComponent('%0A'), 'Wave: ', triggerBody()?['Wave'], decodeUriComponent('%0A'), 'Primary owner: ', triggerBody()?['PrimaryOwner']?['Email'], decodeUriComponent('%0A'), 'Secondary owner: ', triggerBody()?['SecondaryOwner']?['Email'], decodeUriComponent('%0A'), 'Sensitivity: ', triggerBody()?['Sensitivity']?['Value'], decodeUriComponent('%0A'), 'External sharing: ', if(equals(triggerBody()?['ExternalSharingRequired'], true), 'Requested', 'Off'))}",
                      "WebhookApprovalCreationInput/itemLink": "@triggerBody()?['{Link}']",
                      "WebhookApprovalCreationInput/itemLinkDescription": "Open the request",
                      "WebhookApprovalCreationInput/enableNotifications": true,
                      "WebhookApprovalCreationInput/enableReassignment": true
                    }
                  },
                  "runAfter": {}
                },
                "Set_SecurityOutcome": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "SecurityOutcome",
                    "value": "@outputs('Approval_InfoSec')?['body/outcome']"
                  },
                  "runAfter": {
                    "Approval_InfoSec": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {}
            },
            "Condition_SecurityCleared": {
              "type": "If",
              "expression": {
                "not": {
                  "equals": [
                    "@variables('SecurityOutcome')",
                    "Reject"
                  ]
                }
              },
              "actions": {
                "Create_site": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('TenantRootUrl')",
                      "parameters/method": "POST",
                      "parameters/uri": "/_api/SPSiteManager/create",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      },
                      "parameters/body": {
                        "request": {
                          "Title": "@{triggerBody()?['Title']}",
                          "Url": "@{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])}",
                          "Lcid": 1033,
                          "WebTemplate": "STS#3",
                          "Owner": "@{triggerBody()?['PrimaryOwner']?['Email']}",
                          "Description": "@{triggerBody()?['Purpose']}"
                        }
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Condition_SiteReady": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@body('Create_site')?['SiteStatus']",
                      2
                    ]
                  },
                  "actions": {
                    "Apply_governance_baseline": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_azureautomation",
                          "operationId": "CreateJob",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_azureautomation"
                        },
                        "parameters": {
                          "x-ms-api-version": "2015-10-31",
                          "subscriptionId": "@parameters('AutomationSubscriptionId')",
                          "resourceGroupName": "@parameters('AutomationResourceGroup')",
                          "automationAccountName": "@parameters('AutomationAccountName')",
                          "runbookName": "Set-SiteGovernanceBaseline",
                          "wait": true,
                          "properties/parameters/SiteUrl": "@{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])}",
                          "properties/parameters/SecondaryOwner": "@{triggerBody()?['SecondaryOwner']?['Email']}",
                          "properties/parameters/OwnersGroupId": "@{triggerBody()?['OwnersGroupId']}",
                          "properties/parameters/MembersGroupId": "@{triggerBody()?['MembersGroupId']}",
                          "properties/parameters/VisitorsGroupId": "@{triggerBody()?['VisitorsGroupId']}",
                          "properties/parameters/ExternalSharing": "@{if(equals(triggerBody()?['ExternalSharingRequired'], true), 'ExistingExternalUserSharingOnly', 'Disabled')}",
                          "properties/parameters/SensitivityLabel": "@{triggerBody()?['Sensitivity']?['Value']}"
                        }
                      },
                      "runAfter": {}
                    },
                    "Add_to_site_register": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('GovernanceSiteUrl')",
                          "table": "Site Register",
                          "item/Title": "@triggerBody()?['Title']",
                          "item/SiteTitle": "@triggerBody()?['Title']",
                          "item/SiteUrl": "@{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])}",
                          "item/Department": "@triggerBody()?['Department']",
                          "item/Wave": "@triggerBody()?['Wave']",
                          "item/PrimaryOwner/Claims": "@triggerBody()?['PrimaryOwner']?['Claims']",
                          "item/SecondaryOwner/Claims": "@triggerBody()?['SecondaryOwner']?['Claims']",
                          "item/OwnersGroupId": "@triggerBody()?['OwnersGroupId']",
                          "item/MembersGroupId": "@triggerBody()?['MembersGroupId']",
                          "item/VisitorsGroupId": "@triggerBody()?['VisitorsGroupId']",
                          "item/GuestsGroupId": "@triggerBody()?['GuestsGroupId']",
                          "item/SharingCapability": "@if(equals(triggerBody()?['ExternalSharingRequired'], true), 'ExistingExternalUserSharingOnly', 'Disabled')",
                          "item/Sensitivity/Value": "@triggerBody()?['Sensitivity']?['Value']",
                          "item/Status/Value": "Active",
                          "item/NextAccessReview": "@addDays(utcNow(), 90)"
                        }
                      },
                      "runAfter": {
                        "Apply_governance_baseline": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Mark_provisioned": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('GovernanceSiteUrl')",
                          "table": "Site Requests",
                          "id": "@triggerBody()?['ID']",
                          "item/Status/Value": "Provisioned",
                          "item/SiteUrl": "@{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])}"
                        }
                      },
                      "runAfter": {
                        "Add_to_site_register": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Notify_owners": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/To": "@{concat(triggerBody()?['PrimaryOwner']?['Email'], ';', triggerBody()?['SecondaryOwner']?['Email'])}",
                          "emailMessage/Subject": "@{concat('Your SharePoint site is ready: ', triggerBody()?['Title'])}",
                          "emailMessage/Body": "<p>@{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])} has been created with the agreed governance baseline: permissions through security groups, external sharing @{if(equals(triggerBody()?['ExternalSharingRequired'], true), 'limited to existing guests', 'off')}, and sensitivity <b>@{triggerBody()?['Sensitivity']?['Value']}</b>.</p><p>As site owners you are accountable for its content and access, and will be asked to recertify access every 90 days.</p>",
                          "emailMessage/Importance": "Normal",
                          "emailMessage/Cc": "@parameters('ProjectManagerEmail')"
                        }
                      },
                      "runAfter": {
                        "Mark_provisioned": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Mark_failed": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('GovernanceSiteUrl')",
                            "table": "Site Requests",
                            "id": "@triggerBody()?['ID']",
                            "item/Status/Value": "Provisioning failed",
                            "item/DecisionLog": "@{concat('SPSiteManager returned SiteStatus ', string(body('Create_site')?['SiteStatus']), '. 3 = error, 0 = alias already in use.')}"
                          }
                        },
                        "runAfter": {}
                      },
                      "Notify_PM_failed": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_office365",
                            "operationId": "SendEmailV2",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                          },
                          "parameters": {
                            "emailMessage/To": "@parameters('ProjectManagerEmail')",
                            "emailMessage/Subject": "@{concat('Site provisioning failed: ', triggerBody()?['Title'])}",
                            "emailMessage/Body": "<p>Site creation for @{concat(parameters('TenantRootUrl'), '/sites/', triggerBody()?['SiteAlias'])} did not complete (SiteStatus @{body('Create_site')?['SiteStatus']}). Check that the alias is free and retry.</p>",
                            "emailMessage/Importance": "Normal"
                          }
                        },
                        "runAfter": {
                          "Mark_failed": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {
                    "Create_site": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Mark_rejected_InfoSec": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_sharepointonline",
                        "operationId": "PatchItem",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                      },
                      "parameters": {
                        "dataset": "@parameters('GovernanceSiteUrl')",
                        "table": "Site Requests",
                        "id": "@triggerBody()?['ID']",
                        "item/Status/Value": "Rejected",
                        "item/DecisionLog": "@{join(xpath(xml(json(concat('{\"root\":{\"r\":', string(outputs('Approval_InfoSec')?['body/responses']), '}}'))), '//comments/text()'), ' | ')}"
                      }
                    },
                    "runAfter": {}
                  },
                  "Notify_rejected_InfoSec": {
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_office365",
                        "operationId": "SendEmailV2",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                      },
                      "parameters": {
                        "emailMessage/To": "@{triggerBody()?['Requester']?['Email']}",
                        "emailMessage/Subject": "Site request rejected by Information Security",
                        "emailMessage/Body": "<p>Comments: @{join(xpath(xml(json(concat('{\"root\":{\"r\":', string(outputs('Approval_InfoSec')?['body/responses']), '}}'))), '//comments/text()'), ' | ')}</p>",
                        "emailMessage/Importance": "Normal"
                      }
                    },
                    "runAfter": {
                      "Mark_rejected_InfoSec": [
                        "Succeeded"
                      ]
                    }
                  }
                }
              },
              "runAfter": {
                "Condition_NeedsInfoSec": [
                  "Succeeded"
                ]
              }
            }
          },
          "else": {
            "actions": {
              "Mark_rejected_PM": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_sharepointonline",
                    "operationId": "PatchItem",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                  },
                  "parameters": {
                    "dataset": "@parameters('GovernanceSiteUrl')",
                    "table": "Site Requests",
                    "id": "@triggerBody()?['ID']",
                    "item/Status/Value": "Rejected",
                    "item/DecisionLog": "@{join(xpath(xml(json(concat('{\"root\":{\"r\":', string(outputs('Approval_PM')?['body/responses']), '}}'))), '//comments/text()'), ' | ')}"
                  }
                },
                "runAfter": {}
              },
              "Notify_rejected_PM": {
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_office365",
                    "operationId": "SendEmailV2",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                  },
                  "parameters": {
                    "emailMessage/To": "@{triggerBody()?['Requester']?['Email']}",
                    "emailMessage/Subject": "Site request rejected",
                    "emailMessage/Body": "<p>Comments: @{join(xpath(xml(json(concat('{\"root\":{\"r\":', string(outputs('Approval_PM')?['body/responses']), '}}'))), '//comments/text()'), ' | ')}</p>",
                    "emailMessage/Importance": "Normal"
                  }
                },
                "runAfter": {
                  "Mark_rejected_PM": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Approval_PM": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "Mark_invalid": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_sharepointonline",
                "operationId": "PatchItem",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
              },
              "parameters": {
                "dataset": "@parameters('GovernanceSiteUrl')",
                "table": "Site Requests",
                "id": "@triggerBody()?['ID']",
                "item/Status/Value": "Returned - Ownership invalid",
                "item/DecisionLog": "Every site needs two different named, enabled, internal owners (no service/shared accounts) and Owners/Members security groups."
              }
            },
            "runAfter": {}
          },
          "Notify_invalid": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage/To": "@{triggerBody()?['Requester']?['Email']}",
                "emailMessage/Subject": "Site request returned: ownership details invalid",
                "emailMessage/Body": "<p>Every SharePoint site needs a primary and a secondary owner who are two different, enabled, internal named users (service and shared accounts are not allowed), and Owners and Members security groups. Correct the request and resubmit.</p>",
                "emailMessage/Importance": "Normal"
              }
            },
            "runAfter": {
              "Mark_invalid": [
                "Succeeded"
              ]
            }
          }
        }
      },
      "runAfter": {
        "Get_secondary_owner": [
          "Succeeded",
          "Failed"
        ]
      }
    }
  }
}
