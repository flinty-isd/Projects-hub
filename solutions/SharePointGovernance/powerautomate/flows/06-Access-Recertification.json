{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "Quarterly privileged role review",
  "description": "Runs on the 1st of each month and acts in January, April, July and October: asks InfoSec to review SharePoint Administrator role assignments, where only PIM-eligible assignments are expected, and logs the outcome in the Access Review Log. Site access reviews and ownerless-site detection moved to SharePoint Advanced Management (site attestation and site ownership policies, D-GSA-08).",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_approvals": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
    },
    "shared_webcontents": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "GovernanceSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{governance-site}"
    },
    "TenantRootUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com"
    },
    "SharePointServiceOwnerEmail": {
      "type": "String",
      "defaultValue": "{sharepoint-service-owner}@{domain}"
    },
    "InfoSecApproverEmail": {
      "type": "String",
      "defaultValue": "{security-and-architecture}@{domain}"
    },
    "ITOpsOwnerEmail": {
      "type": "String",
      "defaultValue": "{it-operations-owner}@{domain}"
    },
    "ServiceDeskEmail": {
      "type": "String",
      "defaultValue": "{service-desk}@{domain}"
    }
  },
  "triggers": {
    "Monthly_on_the_1st": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Month",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "startTime": "2026-11-01T07:00:00Z",
        "schedule": {
          "hours": [
            7
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Is_quarter_month": {
      "type": "Compose",
      "runAfter": {},
      "inputs": "@equals(mod(int(utcNow('MM')), 3), 1)"
    },
    "Condition_Quarterly_privileged_review": {
      "type": "If",
      "expression": {
        "equals": [
          "@outputs('Is_quarter_month')",
          true
        ]
      },
      "actions": {
        "Get_SharePoint_admin_assignments": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_webcontents",
              "operationId": "InvokeHttp",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
            },
            "parameters": {
              "request/method": "GET",
              "request/url": "https://graph.microsoft.com/v1.0/roleManagement/directory/roleAssignmentScheduleInstances?$filter=roleDefinitionId eq 'f28a1f50-f6e7-4571-818b-6a12f2af6b6c'&$expand=principal"
            }
          },
          "runAfter": {}
        },
        "Get_SharePoint_admin_eligibility": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_webcontents",
              "operationId": "InvokeHttp",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
            },
            "parameters": {
              "request/method": "GET",
              "request/url": "https://graph.microsoft.com/v1.0/roleManagement/directory/roleEligibilityScheduleInstances?$filter=roleDefinitionId eq 'f28a1f50-f6e7-4571-818b-6a12f2af6b6c'&$expand=principal"
            }
          },
          "runAfter": {
            "Get_SharePoint_admin_assignments": [
              "Succeeded"
            ]
          }
        },
        "Approval_InfoSec_privileged": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_approvals",
              "operationId": "StartAndWaitForAnApproval",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals"
            },
            "parameters": {
              "approvalType": "Basic",
              "WebhookApprovalCreationInput/title": "Quarterly review: SharePoint Administrator role",
              "WebhookApprovalCreationInput/assignedTo": "@parameters('InfoSecApproverEmail')",
              "WebhookApprovalCreationInput/details": "@{concat('Active assignments: ', string(length(body('Get_SharePoint_admin_assignments')?['value'])), decodeUriComponent('%0A'), 'Eligible (PIM) assignments: ', string(length(body('Get_SharePoint_admin_eligibility')?['value'])), decodeUriComponent('%0A%0A'), 'Active (permanent) assignments should be zero; all admin access should be PIM-eligible. Approve to confirm, or reject and list the changes.')}",
              "WebhookApprovalCreationInput/itemLink": "https://entra.microsoft.com/#view/Microsoft_Azure_PIMCommon/ResourceMenuBlade/~/members/resourceId//resourceType/tenant/provider/aadroles",
              "WebhookApprovalCreationInput/itemLinkDescription": "Open the request",
              "WebhookApprovalCreationInput/enableNotifications": true,
              "WebhookApprovalCreationInput/enableReassignment": true
            }
          },
          "runAfter": {
            "Get_SharePoint_admin_eligibility": [
              "Succeeded"
            ]
          }
        },
        "Log_privileged_review": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "PostItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('GovernanceSiteUrl')",
              "table": "Access Review Log",
              "item/Title": "@{concat('SharePoint Administrator role - ', utcNow('yyyy-MM-dd'))}",
              "item/Outcome/Value": "@outputs('Approval_InfoSec_privileged')?['body/outcome']",
              "item/Reviewer": "@{outputs('Approval_InfoSec_privileged')?['body/responses'][0]['responder']['email']}",
              "item/Comments": "@{join(xpath(xml(json(concat('{\"root\":{\"r\":', string(outputs('Approval_InfoSec_privileged')?['body/responses']), '}}'))), '//comments/text()'), ' | ')}"
            }
          },
          "runAfter": {
            "Approval_InfoSec_privileged": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Is_quarter_month": [
          "Succeeded"
        ]
      }
    }
  }
}
