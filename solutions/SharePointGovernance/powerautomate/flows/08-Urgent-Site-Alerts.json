{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "Urgent site alerts",
  "description": "Triggers when Site Register items are created or changed; runs one at a time and handles the changed items one by one. Emails a site's owners and the SharePoint service owner at once (high importance) when the site becomes Orphaned - owner inactive, or is Highly Confidential with external sharing not Disabled (InfoSec copied). The alert is claimed in UrgentAlertKey before it is sent, so a concurrent or repeated run can't send it twice; it is cleared when the issue is fixed so it can alert again if it recurs. If sending fails the key is marked SEND FAILED and support is told; it is not retried automatically. Notify only (G-11). Does nothing while UrgentAlertsEnabled is No.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "GovernanceSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{governance-site}"
    },
    "SharePointServiceOwnerEmail": {
      "type": "String",
      "defaultValue": "{sharepoint-service-owner}@{domain}"
    },
    "InfoSecApproverEmail": {
      "type": "String",
      "defaultValue": "{security-and-architecture}@{domain}"
    },
    "UrgentAlertsEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "SupportMailboxEmail": {
      "type": "String",
      "defaultValue": ""
    }
  },
  "triggers": {
    "When_a_site_register_item_changes": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('GovernanceSiteUrl')",
          "table": "Site Register"
        }
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 5
      },
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      }
    }
  },
  "actions": {
    "Condition_Alerts_enabled": {
      "type": "If",
      "expression": {
        "equals": [
          "@parameters('UrgentAlertsEnabled')",
          true
        ]
      },
      "runAfter": {},
      "actions": {
        "For_each_changed_site": {
          "type": "Foreach",
          "foreach": "@triggerOutputs()?['body/value']",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {},
          "actions": {
            "Compose_alert_key": {
              "type": "Compose",
              "inputs": "@concat(if(equals(items('For_each_changed_site')?['Status']?['Value'], 'Orphaned - owner inactive'), 'orphaned;', ''), if(and(equals(items('For_each_changed_site')?['Sensitivity']?['Value'], 'Highly Confidential'), not(equals(items('For_each_changed_site')?['SharingCapability']?['Value'], 'Disabled'))), concat('hc-sharing:', coalesce(items('For_each_changed_site')?['SharingCapability']?['Value'], 'not set'), ';'), ''))",
              "runAfter": {}
            },
            "Condition_New_alert": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@outputs('Compose_alert_key')",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@outputs('Compose_alert_key')",
                        "@coalesce(items('For_each_changed_site')?['UrgentAlertKey'], '')"
                      ]
                    }
                  },
                  {
                    "not": {
                      "startsWith": [
                        "@coalesce(items('For_each_changed_site')?['UrgentAlertKey'], '')",
                        "SEND FAILED"
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Claim_alert": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('GovernanceSiteUrl')",
                      "table": "Site Register",
                      "id": "@items('For_each_changed_site')?['ID']",
                      "item/UrgentAlertKey": "@outputs('Compose_alert_key')"
                    }
                  },
                  "runAfter": {}
                },
                "Send_urgent_alert": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{concat(coalesce(items('For_each_changed_site')?['PrimaryOwner']?['Email'], ''), ';', coalesce(items('For_each_changed_site')?['SecondaryOwner']?['Email'], ''), ';', parameters('SharePointServiceOwnerEmail'), if(and(equals(items('For_each_changed_site')?['Sensitivity']?['Value'], 'Highly Confidential'), not(equals(items('For_each_changed_site')?['SharingCapability']?['Value'], 'Disabled'))), concat(';', parameters('InfoSecApproverEmail')), ''))}",
                      "emailMessage/Subject": "@{concat('Action needed on a SharePoint site you own: ', items('For_each_changed_site')?['Title'])}",
                      "emailMessage/Body": "<p>A governance check on <b>@{items('For_each_changed_site')?['Title']}</b> (@{items('For_each_changed_site')?['SiteUrl']}) needs attention now:</p><ul>@{concat(if(equals(items('For_each_changed_site')?['Status']?['Value'], 'Orphaned - owner inactive'), '<li><b>Orphaned - owner inactive</b>: the primary owner has left or been disabled. Name a new owner through a site change request; the secondary owner keeps the site running meanwhile.</li>', ''), if(and(equals(items('For_each_changed_site')?['Sensitivity']?['Value'], 'Highly Confidential'), not(equals(items('For_each_changed_site')?['SharingCapability']?['Value'], 'Disabled'))), concat('<li><b>Highly Confidential with external sharing ', coalesce(items('For_each_changed_site')?['SharingCapability']?['Value'], 'not set'), '</b>: external sharing must be Disabled on Highly Confidential sites unless InfoSec has approved it. Confirm the approval with InfoSec or ask IT to switch sharing off.</li>'), ''))}</ul><p>Nothing has been changed on the site: the decision stays with the owners (G-11). You'll get this alert once; it appears again in the monthly digest until it is fixed.</p>",
                      "emailMessage/Importance": "High"
                    }
                  },
                  "runAfter": {
                    "Claim_alert": [
                      "Succeeded"
                    ]
                  }
                },
                "Record_send_failed": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('GovernanceSiteUrl')",
                      "table": "Site Register",
                      "id": "@items('For_each_changed_site')?['ID']",
                      "item/UrgentAlertKey": "@{concat('SEND FAILED: ', outputs('Compose_alert_key'))}"
                    }
                  },
                  "runAfter": {
                    "Send_urgent_alert": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Alert_support_not_sent": {
                  "type": "OpenApiConnection",
                  "runAfter": {
                    "Record_send_failed": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/To": "@{concat(parameters('SharePointServiceOwnerEmail'), if(empty(parameters('SupportMailboxEmail')), '', concat(';', parameters('SupportMailboxEmail'))))}",
                      "emailMessage/Subject": "@{concat('Urgent site alert NOT sent: ', items('For_each_changed_site')?['Title'])}",
                      "emailMessage/Body": "<p>The urgent alert for @{items('For_each_changed_site')?['Title']} (@{items('For_each_changed_site')?['SiteUrl']}) could not be sent: @{outputs('Compose_alert_key')}. Its Urgent alert sent for column now starts SEND FAILED, so it won't retry by itself. Tell the owners directly, then clear that column to let flow 08 send it again.</p>",
                      "emailMessage/Importance": "High"
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Condition_Cleared": {
                    "type": "If",
                    "expression": {
                      "and": [
                        {
                          "equals": [
                            "@outputs('Compose_alert_key')",
                            ""
                          ]
                        },
                        {
                          "not": {
                            "equals": [
                              "@coalesce(items('For_each_changed_site')?['UrgentAlertKey'], '')",
                              ""
                            ]
                          }
                        }
                      ]
                    },
                    "actions": {
                      "Clear_alert_key": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('GovernanceSiteUrl')",
                            "table": "Site Register",
                            "id": "@items('For_each_changed_site')?['ID']",
                            "item/UrgentAlertKey": ""
                          }
                        },
                        "runAfter": {}
                      }
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {
                "Compose_alert_key": [
                  "Succeeded"
                ]
              }
            }
          }
        }
      }
    }
  }
}
