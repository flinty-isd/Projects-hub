{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "C3b Urgent notice - Other News",
  "description": "Does nothing while DispatchEnabled is No, or for posts first published before UrgentGoLiveDate. Triggers when an urgent news post on Other News is published (a major version, Status Live, Urgent Yes, UrgentSent No). Only posts authored or last edited by an authorised urgent publisher (UrgentPublisherEmails) are sent; others are logged and Communications is told. Audience-targeted posts are never broadcast to whole ports: Communications is told instead. Otherwise it sends the notice once per matching Comms Distribution port and channel (email from the Communications mailbox, Teams channel post), keyed by site, page, NotificationRound, port and channel in the Delivery Log, and reserves each key before sending, so edits and re-runs never resend; an unknown outcome is logged as Reconcile for a person to check. UrgentSent is set only when every delivery succeeds, without creating a new page version. To send again, Communications sets UrgentSent back to No and raises NotificationRound by one.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    },
    "shared_teams": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "HPUKNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{hpuk-news}"
    },
    "OtherNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{other-news}"
    },
    "CommsSenderMailbox": {
      "type": "String",
      "defaultValue": "{communications-shared-mailbox}@{domain}"
    },
    "CommsTeamEmail": {
      "type": "String",
      "defaultValue": "{communications-team}@{domain}"
    },
    "SupportOwnerEmail": {
      "type": "String",
      "defaultValue": "{news-support-owner}@{domain}"
    },
    "UrgentPublisherEmails": {
      "type": "String",
      "defaultValue": "{urgent-publisher-1}@{domain};{urgent-publisher-2}@{domain}"
    },
    "DispatchEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "UrgentGoLiveDate": {
      "type": "String",
      "defaultValue": "2099-01-01T00:00:00Z"
    }
  },
  "triggers": {
    "When_a_news_page_is_published": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetOnUpdatedFileItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('OtherNewsSiteUrl')",
          "table": "Site Pages"
        }
      },
      "recurrence": {
        "frequency": "Minute",
        "interval": 1
      },
      "splitOn": "@triggerOutputs()?['body/value']",
      "runtimeConfiguration": {
        "concurrency": {
          "runs": 1
        }
      },
      "conditions": [
        {
          "expression": "@and(equals(triggerBody()?['PromotedState'], 2), equals(triggerBody()?['Urgent'], true), not(equals(triggerBody()?['UrgentSent'], true)), equals(triggerBody()?['Status']?['Value'], 'Live'), endsWith(string(triggerBody()?['{VersionNumber}']), '.0'))"
        }
      ]
    }
  },
  "actions": {
    "Initialize_Failures": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Failures",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_RowId": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "RowId",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Initialize_Failures": [
          "Succeeded"
        ]
      }
    },
    "Condition_dispatch_disabled": {
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@parameters('DispatchEnabled')",
            true
          ]
        }
      },
      "actions": {
        "Dispatch_disabled_stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Cancelled"
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Initialize_RowId": [
          "Succeeded"
        ]
      }
    },
    "Condition_before_go_live": {
      "type": "If",
      "expression": {
        "less": [
          "@ticks(coalesce(triggerBody()?['FirstPublishedDate'], triggerBody()?['Created']))",
          "@ticks(parameters('UrgentGoLiveDate'))"
        ]
      },
      "actions": {
        "Before_go_live_stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Cancelled"
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Condition_dispatch_disabled": [
          "Succeeded"
        ]
      }
    },
    "Notification_round": {
      "type": "Compose",
      "inputs": "@coalesce(triggerBody()?['NotificationRound'], 1)",
      "runAfter": {
        "Condition_before_go_live": [
          "Succeeded"
        ]
      }
    },
    "Dispatch_prefix": {
      "type": "Compose",
      "inputs": "@concat('urgent|Other News|', string(triggerBody()?['ID']), '|r', string(outputs('Notification_round')))",
      "runAfter": {
        "Notification_round": [
          "Succeeded"
        ]
      }
    },
    "Condition_urgent_publisher": {
      "type": "If",
      "expression": {
        "not": {
          "or": [
            {
              "contains": [
                "@toLower(parameters('UrgentPublisherEmails'))",
                "@toLower(coalesce(triggerBody()?['Editor']?['Email'], '-'))"
              ]
            },
            {
              "contains": [
                "@toLower(parameters('UrgentPublisherEmails'))",
                "@toLower(coalesce(triggerBody()?['Author']?['Email'], '-'))"
              ]
            }
          ]
        }
      },
      "actions": {
        "NotAuthorised_Check_log": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('HPUKNewsSiteUrl')",
              "table": "Delivery Log",
              "$filter": "@{concat('Title eq ''', outputs('Dispatch_prefix'), '|Skipped - not an urgent publisher''')}",
              "$top": 1
            }
          },
          "runAfter": {}
        },
        "NotAuthorised_Condition_first_time": {
          "type": "If",
          "expression": {
            "equals": [
              "@length(outputs('NotAuthorised_Check_log')?['body/value'])",
              0
            ]
          },
          "actions": {
            "NotAuthorised_Log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HPUKNewsSiteUrl')",
                  "table": "Delivery Log",
                  "item/Title": "@{concat(outputs('Dispatch_prefix'), '|Skipped - not an urgent publisher')}",
                  "item/SourceSite": "Other News",
                  "item/PageId": "@triggerBody()?['ID']",
                  "item/PublishedVersion": "@triggerBody()?['{VersionNumber}']",
                  "item/NotificationRound": "@outputs('Notification_round')",
                  "item/Destination": "(none)",
                  "item/DeliveryStatus/Value": "Skipped - not an urgent publisher",
                  "item/DeliveredAt": "@utcNow()",
                  "item/FlowRunId": "@{workflow()?['run']?['name']}"
                }
              },
              "runAfter": {}
            },
            "NotAuthorised_Tell_Comms": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('CommsTeamEmail')",
                  "emailMessage/Subject": "Urgent notice not sent: publisher not authorised",
                  "emailMessage/Body": "<p><a href=\"@{triggerBody()?['{Link}']}\">@{triggerBody()?['Title']}</a> (Other News)</p><p>This post is marked Urgent, but neither its author (@{triggerBody()?['Author']?['Email']}) nor its last editor (@{triggerBody()?['Editor']?['Email']}) is an authorised urgent publisher, so nothing was sent. If it should go out, an urgent publisher can republish it.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {
                "NotAuthorised_Log": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "NotAuthorised_Check_log": [
              "Succeeded"
            ]
          }
        },
        "NotAuthorised_Stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "NotAuthorised_Condition_first_time": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Dispatch_prefix": [
          "Succeeded"
        ]
      }
    },
    "Condition_audience_targeted": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(coalesce(triggerBody()?['_ModernAudienceTargetUserField'], json('[]')))",
          0
        ]
      },
      "actions": {
        "Audience_Check_log": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('HPUKNewsSiteUrl')",
              "table": "Delivery Log",
              "$filter": "@{concat('Title eq ''', outputs('Dispatch_prefix'), '|Skipped - audience targeted''')}",
              "$top": 1
            }
          },
          "runAfter": {}
        },
        "Audience_Condition_first_time": {
          "type": "If",
          "expression": {
            "equals": [
              "@length(outputs('Audience_Check_log')?['body/value'])",
              0
            ]
          },
          "actions": {
            "Audience_Log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HPUKNewsSiteUrl')",
                  "table": "Delivery Log",
                  "item/Title": "@{concat(outputs('Dispatch_prefix'), '|Skipped - audience targeted')}",
                  "item/SourceSite": "Other News",
                  "item/PageId": "@triggerBody()?['ID']",
                  "item/PublishedVersion": "@triggerBody()?['{VersionNumber}']",
                  "item/NotificationRound": "@outputs('Notification_round')",
                  "item/Destination": "(none)",
                  "item/DeliveryStatus/Value": "Skipped - audience targeted",
                  "item/DeliveredAt": "@utcNow()",
                  "item/FlowRunId": "@{workflow()?['run']?['name']}"
                }
              },
              "runAfter": {}
            },
            "Audience_Tell_Comms": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('CommsTeamEmail')",
                  "emailMessage/Subject": "Urgent notice not broadcast: audience-targeted",
                  "emailMessage/Body": "<p><a href=\"@{triggerBody()?['{Link}']}\">@{triggerBody()?['Title']}</a> (Other News)</p><p>This urgent notice is targeted to an audience, so it was not sent to whole ports. Send it to the intended group directly, or remove the audience and set NotificationRound up by one to broadcast it.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {
                "Audience_Log": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Audience_Check_log": [
              "Succeeded"
            ]
          }
        },
        "Audience_Stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "Audience_Condition_first_time": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Condition_urgent_publisher": [
          "Succeeded"
        ]
      }
    },
    "Get_destinations": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('HPUKNewsSiteUrl')",
          "table": "Comms Distribution",
          "$filter": "Enabled eq 1"
        }
      },
      "runAfter": {
        "Condition_audience_targeted": [
          "Succeeded"
        ]
      }
    },
    "Destinations_for_post": {
      "type": "Query",
      "inputs": {
        "from": "@outputs('Get_destinations')?['body/value']",
        "where": "@or(contains(string(triggerBody()?['Port']), '\"All ports\"'), contains(string(triggerBody()?['Port']), concat('\"', item()?['Port']?['Value'], '\"')))"
      },
      "runAfter": {
        "Get_destinations": [
          "Succeeded"
        ]
      }
    },
    "Condition_no_destinations": {
      "type": "If",
      "expression": {
        "equals": [
          "@length(body('Destinations_for_post'))",
          0
        ]
      },
      "actions": {
        "NoDestination_Check_log": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('HPUKNewsSiteUrl')",
              "table": "Delivery Log",
              "$filter": "@{concat('Title eq ''', outputs('Dispatch_prefix'), '|Skipped - no destinations''')}",
              "$top": 1
            }
          },
          "runAfter": {}
        },
        "NoDestination_Condition_first_time": {
          "type": "If",
          "expression": {
            "equals": [
              "@length(outputs('NoDestination_Check_log')?['body/value'])",
              0
            ]
          },
          "actions": {
            "NoDestination_Log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PostItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HPUKNewsSiteUrl')",
                  "table": "Delivery Log",
                  "item/Title": "@{concat(outputs('Dispatch_prefix'), '|Skipped - no destinations')}",
                  "item/SourceSite": "Other News",
                  "item/PageId": "@triggerBody()?['ID']",
                  "item/PublishedVersion": "@triggerBody()?['{VersionNumber}']",
                  "item/NotificationRound": "@outputs('Notification_round')",
                  "item/Destination": "(none)",
                  "item/DeliveryStatus/Value": "Skipped - no destinations",
                  "item/DeliveredAt": "@utcNow()",
                  "item/FlowRunId": "@{workflow()?['run']?['name']}"
                }
              },
              "runAfter": {}
            },
            "NoDestination_Tell_Comms": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('CommsTeamEmail')",
                  "emailMessage/Subject": "Urgent notice not sent: no enabled destination",
                  "emailMessage/Body": "<p><a href=\"@{triggerBody()?['{Link}']}\">@{triggerBody()?['Title']}</a> (Other News)</p><p>No enabled Comms Distribution row matches this notice's Port. Check the Port value on the post and the Enabled rows in Comms Distribution.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {
                "NoDestination_Log": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "NoDestination_Check_log": [
              "Succeeded"
            ]
          }
        },
        "NoDestination_Stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Succeeded"
          },
          "runAfter": {
            "NoDestination_Condition_first_time": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Destinations_for_post": [
          "Succeeded"
        ]
      }
    },
    "For_each_destination": {
      "type": "Foreach",
      "foreach": "@body('Destinations_for_post')",
      "actions": {
        "Condition_email_destination": {
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@coalesce(items('For_each_destination')?['EmailGroup'], '')",
                ""
              ]
            }
          },
          "actions": {
            "Email_Check_log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HPUKNewsSiteUrl')",
                  "table": "Delivery Log",
                  "$filter": "@{concat('Title eq ''', concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Email'), '''')}",
                  "$top": 1
                }
              },
              "runAfter": {}
            },
            "Email_Condition_can_send": {
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@length(outputs('Email_Check_log')?['body/value'])",
                      0
                    ]
                  },
                  {
                    "equals": [
                      "@first(outputs('Email_Check_log')?['body/value'])?['DeliveryStatus']?['Value']",
                      "Failed"
                    ]
                  }
                ]
              },
              "actions": {
                "Email_Condition_new_key": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@length(outputs('Email_Check_log')?['body/value'])",
                      0
                    ]
                  },
                  "actions": {
                    "Email_Reserve_new": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "item/Title": "@{concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Email')}",
                          "item/DeliveryStatus/Value": "Reserved",
                          "item/DeliveredAt": "@utcNow()",
                          "item/SourceSite": "Other News",
                          "item/PageId": "@triggerBody()?['ID']",
                          "item/PublishedVersion": "@triggerBody()?['{VersionNumber}']",
                          "item/NotificationRound": "@outputs('Notification_round')",
                          "item/Destination": "@items('For_each_destination')?['EmailGroup']",
                          "item/Channel/Value": "Email",
                          "item/FlowRunId": "@{workflow()?['run']?['name']}"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runAfter": {}
                    },
                    "Email_Set_row_new": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "RowId",
                        "value": "@outputs('Email_Reserve_new')?['body/ID']"
                      },
                      "runAfter": {
                        "Email_Reserve_new": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Email_Reserve_retry": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('HPUKNewsSiteUrl')",
                            "table": "Delivery Log",
                            "id": "@first(outputs('Email_Check_log')?['body/value'])?['ID']",
                            "item/DeliveryStatus/Value": "Reserved",
                            "item/DeliveredAt": "@utcNow()",
                            "item/FlowRunId": "@{workflow()?['run']?['name']}"
                          },
                          "retryPolicy": {
                            "type": "none"
                          }
                        },
                        "runAfter": {}
                      },
                      "Email_Set_row_retry": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "RowId",
                          "value": "@first(outputs('Email_Check_log')?['body/value'])?['ID']"
                        },
                        "runAfter": {
                          "Email_Reserve_retry": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Email_Record_reservation_failure": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Email'), ': not sent, the Delivery Log reservation failed')}"
                  },
                  "runAfter": {
                    "Email_Condition_new_key": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Email_Send": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_office365",
                      "operationId": "SharedMailboxSendEmailV2",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                    },
                    "parameters": {
                      "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                      "emailMessage/To": "@items('For_each_destination')?['EmailGroup']",
                      "emailMessage/Subject": "@{concat('Urgent: ', triggerBody()?['Title'])}",
                      "emailMessage/Body": "<p><b>@{triggerBody()?['Title']}</b></p><p>@{coalesce(triggerBody()?['Description'], '')}</p><p><a href=\"@{triggerBody()?['{Link}']}\">Read the full notice</a></p>",
                      "emailMessage/Importance": "High"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {
                    "Email_Condition_new_key": [
                      "Succeeded"
                    ]
                  }
                },
                "Email_Mark_sent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "id": "@variables('RowId')",
                      "item/DeliveryStatus/Value": "Sent",
                      "item/DeliveredAt": "@utcNow()"
                    }
                  },
                  "runAfter": {
                    "Email_Send": [
                      "Succeeded"
                    ]
                  }
                },
                "Email_Record_unlogged_send": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Email'), ': sent, but its Delivery Log row is still Reserved')}"
                  },
                  "runAfter": {
                    "Email_Mark_sent": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Email_Mark_not_sent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "id": "@variables('RowId')",
                      "item/DeliveryStatus/Value": "@{if(and(greaterOrEquals(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 429))), 'Failed', 'Reconcile')}",
                      "item/DeliveredAt": "@utcNow()",
                      "item/ErrorDetail": "@{string(actions('Email_Send')?['outputs']?['body'])}"
                    }
                  },
                  "runAfter": {
                    "Email_Send": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Email_Record_failure": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Email'), ': ', if(and(greaterOrEquals(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 429))), 'rejected, logged as Failed', 'outcome unknown, logged as Reconcile'), ' (', string(actions('Email_Send')?['outputs']?['statusCode']), ')')}"
                  },
                  "runAfter": {
                    "Email_Mark_not_sent": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runAfter": {
                "Email_Check_log": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Condition_teams_destination": {
          "type": "If",
          "expression": {
            "and": [
              {
                "not": {
                  "equals": [
                    "@coalesce(items('For_each_destination')?['TeamId'], '')",
                    ""
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@coalesce(items('For_each_destination')?['ChannelId'], '')",
                    ""
                  ]
                }
              }
            ]
          },
          "actions": {
            "Teams_Check_log": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@parameters('HPUKNewsSiteUrl')",
                  "table": "Delivery Log",
                  "$filter": "@{concat('Title eq ''', concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Teams'), '''')}",
                  "$top": 1
                }
              },
              "runAfter": {}
            },
            "Teams_Condition_can_send": {
              "type": "If",
              "expression": {
                "or": [
                  {
                    "equals": [
                      "@length(outputs('Teams_Check_log')?['body/value'])",
                      0
                    ]
                  },
                  {
                    "equals": [
                      "@first(outputs('Teams_Check_log')?['body/value'])?['DeliveryStatus']?['Value']",
                      "Failed"
                    ]
                  }
                ]
              },
              "actions": {
                "Teams_Condition_new_key": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@length(outputs('Teams_Check_log')?['body/value'])",
                      0
                    ]
                  },
                  "actions": {
                    "Teams_Reserve_new": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PostItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "item/Title": "@{concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Teams')}",
                          "item/DeliveryStatus/Value": "Reserved",
                          "item/DeliveredAt": "@utcNow()",
                          "item/SourceSite": "Other News",
                          "item/PageId": "@triggerBody()?['ID']",
                          "item/PublishedVersion": "@triggerBody()?['{VersionNumber}']",
                          "item/NotificationRound": "@outputs('Notification_round')",
                          "item/Destination": "@{concat(items('For_each_destination')?['TeamId'], '/', items('For_each_destination')?['ChannelId'])}",
                          "item/Channel/Value": "Teams",
                          "item/FlowRunId": "@{workflow()?['run']?['name']}"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runAfter": {}
                    },
                    "Teams_Set_row_new": {
                      "type": "SetVariable",
                      "inputs": {
                        "name": "RowId",
                        "value": "@outputs('Teams_Reserve_new')?['body/ID']"
                      },
                      "runAfter": {
                        "Teams_Reserve_new": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "else": {
                    "actions": {
                      "Teams_Reserve_retry": {
                        "type": "OpenApiConnection",
                        "inputs": {
                          "host": {
                            "connectionName": "shared_sharepointonline",
                            "operationId": "PatchItem",
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                          },
                          "parameters": {
                            "dataset": "@parameters('HPUKNewsSiteUrl')",
                            "table": "Delivery Log",
                            "id": "@first(outputs('Teams_Check_log')?['body/value'])?['ID']",
                            "item/DeliveryStatus/Value": "Reserved",
                            "item/DeliveredAt": "@utcNow()",
                            "item/FlowRunId": "@{workflow()?['run']?['name']}"
                          },
                          "retryPolicy": {
                            "type": "none"
                          }
                        },
                        "runAfter": {}
                      },
                      "Teams_Set_row_retry": {
                        "type": "SetVariable",
                        "inputs": {
                          "name": "RowId",
                          "value": "@first(outputs('Teams_Check_log')?['body/value'])?['ID']"
                        },
                        "runAfter": {
                          "Teams_Reserve_retry": [
                            "Succeeded"
                          ]
                        }
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Teams_Record_reservation_failure": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Teams'), ': not sent, the Delivery Log reservation failed')}"
                  },
                  "runAfter": {
                    "Teams_Condition_new_key": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Teams_Send": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_teams",
                      "operationId": "PostMessageToConversation",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                    },
                    "parameters": {
                      "poster": "Flow bot",
                      "location": "Channel",
                      "body/recipient/groupId": "@items('For_each_destination')?['TeamId']",
                      "body/recipient/channelId": "@items('For_each_destination')?['ChannelId']",
                      "body/messageBody": "<p><b>Urgent</b></p><p><b>@{triggerBody()?['Title']}</b></p><p>@{coalesce(triggerBody()?['Description'], '')}</p><p><a href=\"@{triggerBody()?['{Link}']}\">Read the full notice</a></p>"
                    },
                    "retryPolicy": {
                      "type": "none"
                    }
                  },
                  "runAfter": {
                    "Teams_Condition_new_key": [
                      "Succeeded"
                    ]
                  }
                },
                "Teams_Mark_sent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "id": "@variables('RowId')",
                      "item/DeliveryStatus/Value": "Sent",
                      "item/DeliveredAt": "@utcNow()"
                    }
                  },
                  "runAfter": {
                    "Teams_Send": [
                      "Succeeded"
                    ]
                  }
                },
                "Teams_Record_unlogged_send": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Teams'), ': sent, but its Delivery Log row is still Reserved')}"
                  },
                  "runAfter": {
                    "Teams_Mark_sent": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Teams_Mark_not_sent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "PatchItem",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "id": "@variables('RowId')",
                      "item/DeliveryStatus/Value": "@{if(and(greaterOrEquals(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 429))), 'Failed', 'Reconcile')}",
                      "item/DeliveredAt": "@utcNow()",
                      "item/ErrorDetail": "@{string(actions('Teams_Send')?['outputs']?['body'])}"
                    }
                  },
                  "runAfter": {
                    "Teams_Send": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Teams_Record_failure": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(outputs('Dispatch_prefix'), '|', items('For_each_destination')?['Port']?['Value'], '|Teams'), ': ', if(and(greaterOrEquals(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 429))), 'rejected, logged as Failed', 'outcome unknown, logged as Reconcile'), ' (', string(actions('Teams_Send')?['outputs']?['statusCode']), ')')}"
                  },
                  "runAfter": {
                    "Teams_Mark_not_sent": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runAfter": {
                "Teams_Check_log": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Condition_email_destination": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          }
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "runAfter": {
        "Condition_no_destinations": [
          "Succeeded"
        ]
      }
    },
    "Condition_all_sent": {
      "type": "If",
      "expression": {
        "equals": [
          "@length(variables('Failures'))",
          0
        ]
      },
      "actions": {
        "Mark_urgent_sent": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "HttpRequest",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@parameters('OtherNewsSiteUrl')",
              "parameters/method": "POST",
              "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{triggerBody()?['ID']})/ValidateUpdateListItem",
              "parameters/headers": {
                "Accept": "application/json;odata=nometadata",
                "Content-Type": "application/json;odata=nometadata"
              },
              "parameters/body": {
                "formValues": [
                  {
                    "FieldName": "UrgentSent",
                    "FieldValue": "1"
                  }
                ],
                "bNewDocumentUpdate": true
              }
            }
          },
          "runAfter": {}
        }
      },
      "else": {
        "actions": {
          "Alert_support": {
            "type": "OpenApiConnection",
            "inputs": {
              "host": {
                "connectionName": "shared_office365",
                "operationId": "SendEmailV2",
                "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
              },
              "parameters": {
                "emailMessage/To": "@{concat(parameters('SupportOwnerEmail'), ';', parameters('CommsTeamEmail'))}",
                "emailMessage/Subject": "Urgent notice: some deliveries failed",
                "emailMessage/Body": "<p><a href=\"@{triggerBody()?['{Link}']}\">@{triggerBody()?['Title']}</a> (Other News)</p><p>These deliveries did not complete:</p><p>@{join(variables('Failures'), '<br>')}</p><p>UrgentSent has been left at No.</p><p>A row logged as <b>Reconcile</b> may or may not have arrived: check with the recipient. If it didn't arrive, set the row's Delivery status to Failed and resubmit this run. Only Failed rows are ever retried. A row still <b>Reserved</b> was sent but not logged: set it to Sent.</p>",
                "emailMessage/Importance": "Normal"
              }
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "For_each_destination": [
          "Succeeded",
          "Failed"
        ]
      }
    }
  }
}
