{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "C2 Weekly port news roundup",
  "description": "Runs Mondays at 07:00 UK time. Collects published, Live posts from HPUK News and Other News first published in the previous week (Monday 00:00 to Monday 00:00 UK time) with InRoundup set, leaves out audience-targeted posts, and sends each enabled Comms Distribution port a digest of the posts tagged for that port or All ports, by email from the Communications mailbox and to its Teams channel. Ports with no posts get nothing. Each port and channel is reserved in the Delivery Log before it is sent, at most once a week; a re-run sends only rows logged as Failed. Does nothing while DispatchEnabled is No. With RoundupGroupByTheme = Yes the digest is grouped under the strategy themes (Our People, Our Business, Our Environment, One TEAM), then Other news.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    },
    "shared_teams": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "HPUKNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{hpuk-news}"
    },
    "OtherNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{other-news}"
    },
    "CommsSenderMailbox": {
      "type": "String",
      "defaultValue": "{communications-shared-mailbox}@{domain}"
    },
    "CommsTeamEmail": {
      "type": "String",
      "defaultValue": "{communications-team}@{domain}"
    },
    "SupportOwnerEmail": {
      "type": "String",
      "defaultValue": "{news-support-owner}@{domain}"
    },
    "UrgentPublisherEmails": {
      "type": "String",
      "defaultValue": "{urgent-publisher-1}@{domain};{urgent-publisher-2}@{domain}"
    },
    "DispatchEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "RoundupGroupByTheme": {
      "type": "Bool",
      "defaultValue": false
    }
  },
  "triggers": {
    "Weekly_Monday_0700_UK": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Week",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "schedule": {
          "hours": [
            7
          ],
          "minutes": [
            0
          ],
          "weekDays": [
            "Monday"
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_Failures": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Failures",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_RowId": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "RowId",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Initialize_Failures": [
          "Succeeded"
        ]
      }
    },
    "Condition_dispatch_disabled": {
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@parameters('DispatchEnabled')",
            true
          ]
        }
      },
      "actions": {
        "Dispatch_disabled_stop": {
          "type": "Terminate",
          "inputs": {
            "runStatus": "Cancelled"
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Initialize_RowId": [
          "Succeeded"
        ]
      }
    },
    "Now_UK": {
      "type": "Compose",
      "inputs": "@convertTimeZone(utcNow(), 'UTC', 'GMT Standard Time')",
      "runAfter": {
        "Condition_dispatch_disabled": [
          "Succeeded"
        ]
      }
    },
    "Week_key": {
      "type": "Compose",
      "inputs": "@formatDateTime(addDays(outputs('Now_UK'), mul(-1, mod(add(dayOfWeek(outputs('Now_UK')), 6), 7))), 'yyyy-MM-dd')",
      "runAfter": {
        "Now_UK": [
          "Succeeded"
        ]
      }
    },
    "Window_start": {
      "type": "Compose",
      "inputs": "@convertToUtc(addDays(outputs('Week_key'), -7, 'yyyy-MM-dd'), 'GMT Standard Time', 'yyyy-MM-ddTHH:mm:ssZ')",
      "runAfter": {
        "Week_key": [
          "Succeeded"
        ]
      }
    },
    "Window_end": {
      "type": "Compose",
      "inputs": "@convertToUtc(outputs('Week_key'), 'GMT Standard Time', 'yyyy-MM-ddTHH:mm:ssZ')",
      "runAfter": {
        "Window_start": [
          "Succeeded"
        ]
      }
    },
    "Week_label": {
      "type": "Compose",
      "inputs": "@concat(formatDateTime(addDays(outputs('Week_key'), -7), 'ddd d MMM'), ' to ', formatDateTime(addDays(outputs('Week_key'), -1), 'ddd d MMM yyyy'))",
      "runAfter": {
        "Window_end": [
          "Succeeded"
        ]
      }
    },
    "Get_HPUK_posts": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('HPUKNewsSiteUrl')",
          "table": "Site Pages",
          "$filter": "@{concat('PromotedState eq 2 and Status eq ''Live'' and InRoundup eq 1 and FirstPublishedDate ge ''', outputs('Window_start'), ''' and FirstPublishedDate lt ''', outputs('Window_end'), '''')}"
        }
      },
      "runAfter": {
        "Week_label": [
          "Succeeded"
        ]
      }
    },
    "Get_Other_posts": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('OtherNewsSiteUrl')",
          "table": "Site Pages",
          "$filter": "@{concat('PromotedState eq 2 and Status eq ''Live'' and InRoundup eq 1 and FirstPublishedDate ge ''', outputs('Window_start'), ''' and FirstPublishedDate lt ''', outputs('Window_end'), '''')}"
        }
      },
      "runAfter": {
        "Get_HPUK_posts": [
          "Succeeded"
        ]
      }
    },
    "Select_HPUK_posts": {
      "type": "Select",
      "inputs": {
        "from": "@outputs('Get_HPUK_posts')?['body/value']",
        "select": {
          "Site": "HPUK News",
          "Title": "@item()?['Title']",
          "Link": "@item()?['{Link}']",
          "Summary": "@coalesce(item()?['Description'], '')",
          "Category": "@coalesce(item()?['Category']?['Label'], '')",
          "Port": "@item()?['Port']",
          "Audience": "@item()?['_ModernAudienceTargetUserField']",
          "Themes": "@string(coalesce(item()?['StrategyTheme'], json('[]')))"
        }
      },
      "runAfter": {
        "Get_Other_posts": [
          "Succeeded"
        ]
      }
    },
    "Select_Other_posts": {
      "type": "Select",
      "inputs": {
        "from": "@outputs('Get_Other_posts')?['body/value']",
        "select": {
          "Site": "Other News",
          "Title": "@item()?['Title']",
          "Link": "@item()?['{Link}']",
          "Summary": "@coalesce(item()?['Description'], '')",
          "Category": "@coalesce(item()?['Category']?['Label'], '')",
          "Port": "@item()?['Port']",
          "Audience": "@item()?['_ModernAudienceTargetUserField']",
          "Themes": "@string(coalesce(item()?['StrategyTheme'], json('[]')))"
        }
      },
      "runAfter": {
        "Select_HPUK_posts": [
          "Succeeded"
        ]
      }
    },
    "Broadcast_posts": {
      "type": "Query",
      "inputs": {
        "from": "@union(body('Select_HPUK_posts'), body('Select_Other_posts'))",
        "where": "@equals(length(coalesce(item()?['Audience'], json('[]'))), 0)"
      },
      "runAfter": {
        "Select_Other_posts": [
          "Succeeded"
        ]
      }
    },
    "Get_destinations": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_sharepointonline",
          "operationId": "GetItems",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
        },
        "parameters": {
          "dataset": "@parameters('HPUKNewsSiteUrl')",
          "table": "Comms Distribution",
          "$filter": "Enabled eq 1"
        }
      },
      "runAfter": {
        "Broadcast_posts": [
          "Succeeded"
        ]
      }
    },
    "For_each_destination": {
      "type": "Foreach",
      "foreach": "@outputs('Get_destinations')?['body/value']",
      "actions": {
        "Posts_for_port": {
          "type": "Query",
          "inputs": {
            "from": "@body('Broadcast_posts')",
            "where": "@or(contains(string(item()?['Port']), '\"All ports\"'), contains(string(item()?['Port']), concat('\"', items('For_each_destination')?['Port']?['Value'], '\"')))"
          },
          "runAfter": {}
        },
        "Condition_has_posts": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(body('Posts_for_port'))",
              0
            ]
          },
          "actions": {
            "Digest_items": {
              "type": "Select",
              "inputs": {
                "from": "@body('Posts_for_port')",
                "select": {
                  "Html": "@concat('<li><a href=\"', item()?['Link'], '\">', item()?['Title'], '</a> (', item()?['Site'], if(empty(item()?['Category']), '', concat(', ', item()?['Category'])), ')', if(empty(item()?['Summary']), '', concat('<br>', item()?['Summary'])), '</li>')",
                  "Themes": "@item()?['Themes']"
                }
              },
              "runAfter": {}
            },
            "Digest_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Digest_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Digest_items": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_People_items": {
              "type": "Query",
              "inputs": {
                "from": "@body('Digest_items')",
                "where": "@contains(item()?['Themes'], '\"Label\":\"Our People\"')"
              },
              "runAfter": {
                "Digest_lines": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_People_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Theme_Our_People_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Theme_Our_People_items": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_Business_items": {
              "type": "Query",
              "inputs": {
                "from": "@body('Digest_items')",
                "where": "@contains(item()?['Themes'], '\"Label\":\"Our Business\"')"
              },
              "runAfter": {
                "Theme_Our_People_lines": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_Business_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Theme_Our_Business_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Theme_Our_Business_items": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_Environment_items": {
              "type": "Query",
              "inputs": {
                "from": "@body('Digest_items')",
                "where": "@contains(item()?['Themes'], '\"Label\":\"Our Environment\"')"
              },
              "runAfter": {
                "Theme_Our_Business_lines": [
                  "Succeeded"
                ]
              }
            },
            "Theme_Our_Environment_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Theme_Our_Environment_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Theme_Our_Environment_items": [
                  "Succeeded"
                ]
              }
            },
            "Theme_One_TEAM_items": {
              "type": "Query",
              "inputs": {
                "from": "@body('Digest_items')",
                "where": "@contains(item()?['Themes'], '\"Label\":\"One TEAM\"')"
              },
              "runAfter": {
                "Theme_Our_Environment_lines": [
                  "Succeeded"
                ]
              }
            },
            "Theme_One_TEAM_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Theme_One_TEAM_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Theme_One_TEAM_items": [
                  "Succeeded"
                ]
              }
            },
            "Theme_none_items": {
              "type": "Query",
              "inputs": {
                "from": "@body('Digest_items')",
                "where": "@not(contains(item()?['Themes'], '\"Label\":'))"
              },
              "runAfter": {
                "Theme_One_TEAM_lines": [
                  "Succeeded"
                ]
              }
            },
            "Theme_none_lines": {
              "type": "Select",
              "inputs": {
                "from": "@body('Theme_none_items')",
                "select": "@item()?['Html']"
              },
              "runAfter": {
                "Theme_none_items": [
                  "Succeeded"
                ]
              }
            },
            "Digest_body": {
              "type": "Compose",
              "inputs": "@{if(equals(parameters('RoundupGroupByTheme'), true), concat(if(empty(body('Theme_Our_People_lines')), '', concat('<h3>Our People</h3><ul>', join(body('Theme_Our_People_lines'), ''), '</ul>')), if(empty(body('Theme_Our_Business_lines')), '', concat('<h3>Our Business</h3><ul>', join(body('Theme_Our_Business_lines'), ''), '</ul>')), if(empty(body('Theme_Our_Environment_lines')), '', concat('<h3>Our Environment</h3><ul>', join(body('Theme_Our_Environment_lines'), ''), '</ul>')), if(empty(body('Theme_One_TEAM_lines')), '', concat('<h3>One TEAM</h3><ul>', join(body('Theme_One_TEAM_lines'), ''), '</ul>')), if(empty(body('Theme_none_lines')), '', concat('<h3>Other news</h3><ul>', join(body('Theme_none_lines'), ''), '</ul>'))), concat('<ul>', join(body('Digest_lines'), ''), '</ul>'))}",
              "runAfter": {
                "Theme_none_lines": [
                  "Succeeded"
                ]
              }
            },
            "Condition_email_destination": {
              "type": "If",
              "expression": {
                "not": {
                  "equals": [
                    "@coalesce(items('For_each_destination')?['EmailGroup'], '')",
                    ""
                  ]
                }
              },
              "actions": {
                "Email_Check_log": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "$filter": "@{concat('Title eq ''', concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Email'), '''')}",
                      "$top": 1
                    }
                  },
                  "runAfter": {}
                },
                "Email_Condition_can_send": {
                  "type": "If",
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@length(outputs('Email_Check_log')?['body/value'])",
                          0
                        ]
                      },
                      {
                        "equals": [
                          "@first(outputs('Email_Check_log')?['body/value'])?['DeliveryStatus']?['Value']",
                          "Failed"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Email_Condition_new_key": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@length(outputs('Email_Check_log')?['body/value'])",
                          0
                        ]
                      },
                      "actions": {
                        "Email_Reserve_new": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('HPUKNewsSiteUrl')",
                              "table": "Delivery Log",
                              "item/Title": "@{concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Email')}",
                              "item/DeliveryStatus/Value": "Reserved",
                              "item/DeliveredAt": "@utcNow()",
                              "item/SourceSite": "Roundup",
                              "item/PageId": 0,
                              "item/PublishedVersion": "@outputs('Week_key')",
                              "item/NotificationRound": 0,
                              "item/Destination": "@items('For_each_destination')?['EmailGroup']",
                              "item/Channel/Value": "Email",
                              "item/FlowRunId": "@{workflow()?['run']?['name']}"
                            },
                            "retryPolicy": {
                              "type": "none"
                            }
                          },
                          "runAfter": {}
                        },
                        "Email_Set_row_new": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "RowId",
                            "value": "@outputs('Email_Reserve_new')?['body/ID']"
                          },
                          "runAfter": {
                            "Email_Reserve_new": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Email_Reserve_retry": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PatchItem",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@parameters('HPUKNewsSiteUrl')",
                                "table": "Delivery Log",
                                "id": "@first(outputs('Email_Check_log')?['body/value'])?['ID']",
                                "item/DeliveryStatus/Value": "Reserved",
                                "item/DeliveredAt": "@utcNow()",
                                "item/FlowRunId": "@{workflow()?['run']?['name']}"
                              },
                              "retryPolicy": {
                                "type": "none"
                              }
                            },
                            "runAfter": {}
                          },
                          "Email_Set_row_retry": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "RowId",
                              "value": "@first(outputs('Email_Check_log')?['body/value'])?['ID']"
                            },
                            "runAfter": {
                              "Email_Reserve_retry": [
                                "Succeeded"
                              ]
                            }
                          }
                        }
                      },
                      "runAfter": {}
                    },
                    "Email_Record_reservation_failure": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Email'), ': not sent, the Delivery Log reservation failed')}"
                      },
                      "runAfter": {
                        "Email_Condition_new_key": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Email_Send": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_office365",
                          "operationId": "SharedMailboxSendEmailV2",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                        },
                        "parameters": {
                          "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                          "emailMessage/To": "@items('For_each_destination')?['EmailGroup']",
                          "emailMessage/Subject": "@{concat('Weekly news roundup: ', items('For_each_destination')?['Port']?['Value'])}",
                          "emailMessage/Body": "<p>News published @{outputs('Week_label')} for <b>@{items('For_each_destination')?['Port']?['Value']}</b>:</p>@{outputs('Digest_body')}<p>Read all current news on the intranet.</p>",
                          "emailMessage/Importance": "Normal"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runAfter": {
                        "Email_Condition_new_key": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Email_Mark_sent": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "id": "@variables('RowId')",
                          "item/DeliveryStatus/Value": "Sent",
                          "item/DeliveredAt": "@utcNow()"
                        }
                      },
                      "runAfter": {
                        "Email_Send": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Email_Record_unlogged_send": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Email'), ': sent, but its Delivery Log row is still Reserved')}"
                      },
                      "runAfter": {
                        "Email_Mark_sent": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Email_Mark_not_sent": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "id": "@variables('RowId')",
                          "item/DeliveryStatus/Value": "@{if(and(greaterOrEquals(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 429))), 'Failed', 'Reconcile')}",
                          "item/DeliveredAt": "@utcNow()",
                          "item/ErrorDetail": "@{string(actions('Email_Send')?['outputs']?['body'])}"
                        }
                      },
                      "runAfter": {
                        "Email_Send": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Email_Record_failure": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Email'), ': ', if(and(greaterOrEquals(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Email_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Email_Send')?['outputs']?['statusCode'], 429))), 'rejected, logged as Failed', 'outcome unknown, logged as Reconcile'), ' (', string(actions('Email_Send')?['outputs']?['statusCode']), ')')}"
                      },
                      "runAfter": {
                        "Email_Mark_not_sent": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Email_Check_log": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Digest_body": [
                  "Succeeded"
                ]
              }
            },
            "Condition_teams_destination": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [
                        "@coalesce(items('For_each_destination')?['TeamId'], '')",
                        ""
                      ]
                    }
                  },
                  {
                    "not": {
                      "equals": [
                        "@coalesce(items('For_each_destination')?['ChannelId'], '')",
                        ""
                      ]
                    }
                  }
                ]
              },
              "actions": {
                "Teams_Check_log": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "GetItems",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@parameters('HPUKNewsSiteUrl')",
                      "table": "Delivery Log",
                      "$filter": "@{concat('Title eq ''', concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Teams'), '''')}",
                      "$top": 1
                    }
                  },
                  "runAfter": {}
                },
                "Teams_Condition_can_send": {
                  "type": "If",
                  "expression": {
                    "or": [
                      {
                        "equals": [
                          "@length(outputs('Teams_Check_log')?['body/value'])",
                          0
                        ]
                      },
                      {
                        "equals": [
                          "@first(outputs('Teams_Check_log')?['body/value'])?['DeliveryStatus']?['Value']",
                          "Failed"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Teams_Condition_new_key": {
                      "type": "If",
                      "expression": {
                        "equals": [
                          "@length(outputs('Teams_Check_log')?['body/value'])",
                          0
                        ]
                      },
                      "actions": {
                        "Teams_Reserve_new": {
                          "type": "OpenApiConnection",
                          "inputs": {
                            "host": {
                              "connectionName": "shared_sharepointonline",
                              "operationId": "PostItem",
                              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                            },
                            "parameters": {
                              "dataset": "@parameters('HPUKNewsSiteUrl')",
                              "table": "Delivery Log",
                              "item/Title": "@{concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Teams')}",
                              "item/DeliveryStatus/Value": "Reserved",
                              "item/DeliveredAt": "@utcNow()",
                              "item/SourceSite": "Roundup",
                              "item/PageId": 0,
                              "item/PublishedVersion": "@outputs('Week_key')",
                              "item/NotificationRound": 0,
                              "item/Destination": "@{concat(items('For_each_destination')?['TeamId'], '/', items('For_each_destination')?['ChannelId'])}",
                              "item/Channel/Value": "Teams",
                              "item/FlowRunId": "@{workflow()?['run']?['name']}"
                            },
                            "retryPolicy": {
                              "type": "none"
                            }
                          },
                          "runAfter": {}
                        },
                        "Teams_Set_row_new": {
                          "type": "SetVariable",
                          "inputs": {
                            "name": "RowId",
                            "value": "@outputs('Teams_Reserve_new')?['body/ID']"
                          },
                          "runAfter": {
                            "Teams_Reserve_new": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Teams_Reserve_retry": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_sharepointonline",
                                "operationId": "PatchItem",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@parameters('HPUKNewsSiteUrl')",
                                "table": "Delivery Log",
                                "id": "@first(outputs('Teams_Check_log')?['body/value'])?['ID']",
                                "item/DeliveryStatus/Value": "Reserved",
                                "item/DeliveredAt": "@utcNow()",
                                "item/FlowRunId": "@{workflow()?['run']?['name']}"
                              },
                              "retryPolicy": {
                                "type": "none"
                              }
                            },
                            "runAfter": {}
                          },
                          "Teams_Set_row_retry": {
                            "type": "SetVariable",
                            "inputs": {
                              "name": "RowId",
                              "value": "@first(outputs('Teams_Check_log')?['body/value'])?['ID']"
                            },
                            "runAfter": {
                              "Teams_Reserve_retry": [
                                "Succeeded"
                              ]
                            }
                          }
                        }
                      },
                      "runAfter": {}
                    },
                    "Teams_Record_reservation_failure": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Teams'), ': not sent, the Delivery Log reservation failed')}"
                      },
                      "runAfter": {
                        "Teams_Condition_new_key": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Teams_Send": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_teams",
                          "operationId": "PostMessageToConversation",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams"
                        },
                        "parameters": {
                          "poster": "Flow bot",
                          "location": "Channel",
                          "body/recipient/groupId": "@items('For_each_destination')?['TeamId']",
                          "body/recipient/channelId": "@items('For_each_destination')?['ChannelId']",
                          "body/messageBody": "<p>News published @{outputs('Week_label')} for <b>@{items('For_each_destination')?['Port']?['Value']}</b>:</p>@{outputs('Digest_body')}<p>Read all current news on the intranet.</p>"
                        },
                        "retryPolicy": {
                          "type": "none"
                        }
                      },
                      "runAfter": {
                        "Teams_Condition_new_key": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Teams_Mark_sent": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "id": "@variables('RowId')",
                          "item/DeliveryStatus/Value": "Sent",
                          "item/DeliveredAt": "@utcNow()"
                        }
                      },
                      "runAfter": {
                        "Teams_Send": [
                          "Succeeded"
                        ]
                      }
                    },
                    "Teams_Record_unlogged_send": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Teams'), ': sent, but its Delivery Log row is still Reserved')}"
                      },
                      "runAfter": {
                        "Teams_Mark_sent": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Teams_Mark_not_sent": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_sharepointonline",
                          "operationId": "PatchItem",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                        },
                        "parameters": {
                          "dataset": "@parameters('HPUKNewsSiteUrl')",
                          "table": "Delivery Log",
                          "id": "@variables('RowId')",
                          "item/DeliveryStatus/Value": "@{if(and(greaterOrEquals(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 429))), 'Failed', 'Reconcile')}",
                          "item/DeliveredAt": "@utcNow()",
                          "item/ErrorDetail": "@{string(actions('Teams_Send')?['outputs']?['body'])}"
                        }
                      },
                      "runAfter": {
                        "Teams_Send": [
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    },
                    "Teams_Record_failure": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(concat('roundup|', outputs('Week_key'), '|', items('For_each_destination')?['Port']?['Value']), '|Teams'), ': ', if(and(greaterOrEquals(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 400), less(coalesce(actions('Teams_Send')?['outputs']?['statusCode'], 0), 500), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 408)), not(equals(actions('Teams_Send')?['outputs']?['statusCode'], 429))), 'rejected, logged as Failed', 'outcome unknown, logged as Reconcile'), ' (', string(actions('Teams_Send')?['outputs']?['statusCode']), ')')}"
                      },
                      "runAfter": {
                        "Teams_Mark_not_sent": [
                          "Succeeded",
                          "Failed",
                          "TimedOut"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Teams_Check_log": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Condition_email_destination": [
                  "Succeeded",
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "runAfter": {
            "Posts_for_port": [
              "Succeeded"
            ]
          }
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "runAfter": {
        "Get_destinations": [
          "Succeeded"
        ]
      }
    },
    "Condition_any_failures": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(variables('Failures'))",
          0
        ]
      },
      "actions": {
        "Alert_support": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@parameters('SupportOwnerEmail')",
              "emailMessage/Subject": "News roundup: some deliveries failed",
              "emailMessage/Body": "<p>These roundup deliveries did not complete:</p><p>@{join(variables('Failures'), '<br>')}</p><p>A row logged as <b>Reconcile</b> may or may not have arrived: check with the recipient. If it didn't arrive, set the row's Delivery status to Failed and resubmit this run. Only Failed rows are ever retried. A row still <b>Reserved</b> was sent but not logged: set it to Sent.</p><p>Destinations already sent for this week are always skipped.</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "For_each_destination": [
          "Succeeded",
          "Failed"
        ]
      }
    }
  }
}
