{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "C1 Expire news posts",
  "description": "Runs daily at 06:00 UK time. On HPUK News and Other News, sets Status to Expired and Show in News to No on every published news post that isn't already expired and whose Expiry Date is before today (Expiry Date is the last day a notice is current). Uses ValidateUpdateListItem so the published page is not re-versioned or left in draft. Pages and attachments are never deleted. Alerts the support owner if any page cannot be updated. While ExpiryWritesEnabled is No (the default) it changes nothing and emails the support owner the pages it would have expired.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "HPUKNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{hpuk-news}"
    },
    "OtherNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{other-news}"
    },
    "CommsSenderMailbox": {
      "type": "String",
      "defaultValue": "{communications-shared-mailbox}@{domain}"
    },
    "CommsTeamEmail": {
      "type": "String",
      "defaultValue": "{communications-team}@{domain}"
    },
    "SupportOwnerEmail": {
      "type": "String",
      "defaultValue": "{news-support-owner}@{domain}"
    },
    "UrgentPublisherEmails": {
      "type": "String",
      "defaultValue": "{urgent-publisher-1}@{domain};{urgent-publisher-2}@{domain}"
    },
    "DispatchEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryWritesEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryReportEmail": {
      "type": "String",
      "defaultValue": ""
    }
  },
  "triggers": {
    "Daily_0600_UK": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "schedule": {
          "hours": [
            6
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_Failures": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Failures",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_WouldExpire": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "WouldExpire",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Failures": [
          "Succeeded"
        ]
      }
    },
    "Initialize_Expired": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Expired",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_WouldExpire": [
          "Succeeded"
        ]
      }
    },
    "Today_UK": {
      "type": "Compose",
      "inputs": "@convertTimeZone(utcNow(), 'UTC', 'GMT Standard Time', 'yyyy-MM-dd')",
      "runAfter": {
        "Initialize_Expired": [
          "Succeeded"
        ]
      }
    },
    "Sites": {
      "type": "Compose",
      "inputs": [
        {
          "key": "HPUK News",
          "url": "@parameters('HPUKNewsSiteUrl')",
          "expiryColumn": "Expiry_x0020_Date"
        },
        {
          "key": "Other News",
          "url": "@parameters('OtherNewsSiteUrl')",
          "expiryColumn": "ExpiryDate"
        }
      ],
      "runAfter": {
        "Today_UK": [
          "Succeeded"
        ]
      }
    },
    "For_each_site": {
      "type": "Foreach",
      "foreach": "@outputs('Sites')",
      "actions": {
        "Get_expired_pages": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "@items('For_each_site')?['url']",
              "table": "Site Pages",
              "$filter": "@{concat('PromotedState eq 2 and ', items('For_each_site')?['expiryColumn'], ' lt ''', outputs('Today_UK'), '''')}"
            }
          },
          "runAfter": {},
          "runtimeConfiguration": {
            "paginationPolicy": {
              "minimumItemCount": 5000
            }
          }
        },
        "Filter_not_yet_expired": {
          "type": "Query",
          "inputs": {
            "from": "@outputs('Get_expired_pages')?['body/value']",
            "where": "@or(not(equals(item()?['Status']?['Value'], 'Expired')), not(equals(item()?['ShowinNews'], false)))"
          },
          "runAfter": {
            "Get_expired_pages": [
              "Succeeded"
            ]
          }
        },
        "For_each_expired_page": {
          "type": "Foreach",
          "foreach": "@body('Filter_not_yet_expired')",
          "actions": {
            "Condition_writes_enabled": {
              "type": "If",
              "expression": {
                "equals": [
                  "@parameters('ExpiryWritesEnabled')",
                  true
                ]
              },
              "actions": {
                "Expire_page": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@items('For_each_site')?['url']",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/ValidateUpdateListItem",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      },
                      "parameters/body": {
                        "formValues": [
                          {
                            "FieldName": "Status",
                            "FieldValue": "Expired"
                          },
                          {
                            "FieldName": "ShowinNews",
                            "FieldValue": "0"
                          }
                        ],
                        "bNewDocumentUpdate": true
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Condition_update_failed": {
                  "type": "If",
                  "expression": {
                    "or": [
                      {
                        "not": {
                          "equals": [
                            "@actions('Expire_page')?['status']",
                            "Succeeded"
                          ]
                        }
                      },
                      {
                        "contains": [
                          "@string(body('Expire_page'))",
                          "\"HasException\":true"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Record_expiry_failure": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Expire_page": [
                      "Succeeded",
                      "Failed",
                      "TimedOut"
                    ]
                  },
                  "else": {
                    "actions": {
                      "Record_expired": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "Expired",
                          "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                        },
                        "runAfter": {}
                      }
                    }
                  }
                }
              },
              "else": {
                "actions": {
                  "Record_would_expire": {
                    "type": "AppendToArrayVariable",
                    "inputs": {
                      "name": "WouldExpire",
                      "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                    },
                    "runAfter": {}
                  }
                }
              },
              "runAfter": {}
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 5
            }
          },
          "runAfter": {
            "Filter_not_yet_expired": [
              "Succeeded"
            ]
          }
        }
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 1
        }
      },
      "runAfter": {
        "Sites": [
          "Succeeded"
        ]
      }
    },
    "Condition_any_failures": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(variables('Failures'))",
          0
        ]
      },
      "actions": {
        "Alert_support": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
              "emailMessage/To": "@parameters('SupportOwnerEmail')",
              "emailMessage/Subject": "News expiry: some pages were not expired",
              "emailMessage/Body": "<p>These news posts passed their expiry date but could not be taken out of the news (Status Expired, Show in News No). They still show as current:</p><p>@{join(variables('Failures'), '<br>')}</p><p>Check the flow run history, then set Status to Expired and Show in News to No by hand, or re-run the flow.</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "For_each_site": [
          "Succeeded",
          "Failed"
        ]
      }
    },
    "Condition_dry_run": {
      "type": "If",
      "expression": {
        "greater": [
          "@length(variables('WouldExpire'))",
          0
        ]
      },
      "actions": {
        "Report_dry_run": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
              "emailMessage/To": "@parameters('SupportOwnerEmail')",
              "emailMessage/Subject": "News expiry (dry run): pages that would be expired",
              "emailMessage/Body": "<p>Expiry writes are switched off (ExpiryWritesEnabled = No), so nothing was changed. With writes on, these posts would have been set to Status Expired and Show in News No:</p><p>@{join(variables('WouldExpire'), '<br>')}</p><p>Once expiry has been proven on a test page (the reader view, page version and approval state stay as they are), set ExpiryWritesEnabled to Yes.</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Condition_any_failures": [
          "Succeeded"
        ]
      }
    },
    "Condition_report_requested": {
      "type": "If",
      "expression": {
        "not": {
          "equals": [
            "@trim(coalesce(parameters('ExpiryReportEmail'), ''))",
            ""
          ]
        }
      },
      "actions": {
        "Send_expiry_report": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
              "emailMessage/To": "@parameters('ExpiryReportEmail')",
              "emailMessage/Subject": "@{concat('News expiry report: ', string(length(variables('Expired'))), ' taken out, ', string(length(variables('Failures'))), ' failed, ', string(length(variables('WouldExpire'))), ' in dry run')}",
              "emailMessage/Body": "<p>News expiry run for @{outputs('Today_UK')} (UK date). Expiry writes are @{if(equals(parameters('ExpiryWritesEnabled'), true), 'on', 'off (dry run: nothing was changed)')}.</p><p><b>Taken out of the news (Status set to Expired, Show in News to No):</b><br>@{if(empty(variables('Expired')), 'None', join(variables('Expired'), '<br>'))}</p><p><b>Could not be updated:</b><br>@{if(empty(variables('Failures')), 'None', join(variables('Failures'), '<br>'))}</p><p><b>Would be taken out if expiry writes were on:</b><br>@{if(empty(variables('WouldExpire')), 'None', join(variables('WouldExpire'), '<br>'))}</p><p>Only published posts not already expired, with an Expiry Date before today, are picked up.</p>",
              "emailMessage/Importance": "Normal"
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Condition_dry_run": [
          "Succeeded"
        ]
      }
    }
  }
}
