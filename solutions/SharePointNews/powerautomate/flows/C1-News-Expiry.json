{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "C1 Expire news posts",
  "description": "Runs daily at 06:00 UK time. On HPUK News and Other News, finds published news posts whose Expiry Date is before today (the Expiry Date is the last day a notice is current) and archives each one: it checks the page out, sets Status Expired, Show in News No and PromotedState 0 (no longer a news post), and checks it in as a published major version. The post leaves every news feed, hub news, Viva and the roundup, but stays readable on the site's News archive page. Success is confirmed by reading the page back (published, Expired, not a news post); anything else is reported with SharePoint's response and the page is not left checked out. Pages and attachments are never deleted. Checked-out pages are reported, not forced. Posts unpublished earlier are left hidden unless ArchiveUnpublishedExpired is Yes. While ExpiryWritesEnabled is No it changes nothing and emails the posts it would archive. ExpiryReportEmail, if set, gets a report of every run.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "HPUKNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{hpuk-news}"
    },
    "OtherNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{other-news}"
    },
    "CommsSenderMailbox": {
      "type": "String",
      "defaultValue": "{communications-shared-mailbox}@{domain}"
    },
    "CommsTeamEmail": {
      "type": "String",
      "defaultValue": "{communications-team}@{domain}"
    },
    "SupportOwnerEmail": {
      "type": "String",
      "defaultValue": "{news-support-owner}@{domain}"
    },
    "UrgentPublisherEmails": {
      "type": "String",
      "defaultValue": "{urgent-publisher-1}@{domain};{urgent-publisher-2}@{domain}"
    },
    "DispatchEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryWritesEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryReportEmail": {
      "type": "String",
      "defaultValue": ""
    },
    "ArchiveUnpublishedExpired": {
      "type": "Bool",
      "defaultValue": false
    }
  },
  "triggers": {
    "Daily_0600_UK": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "schedule": {
          "hours": [
            6
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_Failures": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Failures",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_Archived": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Archived",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Failures": [
          "Succeeded"
        ]
      }
    },
    "Initialize_LeftHidden": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "LeftHidden",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Archived": [
          "Succeeded"
        ]
      }
    },
    "Initialize_WouldArchive": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "WouldArchive",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_LeftHidden": [
          "Succeeded"
        ]
      }
    },
    "Scope_Main": {
      "type": "Scope",
      "actions": {
        "Today_UK": {
          "type": "Compose",
          "inputs": "@convertTimeZone(utcNow(), 'UTC', 'GMT Standard Time', 'yyyy-MM-dd')",
          "runAfter": {}
        },
        "Sites": {
          "type": "Compose",
          "inputs": [
            {
              "key": "HPUK News",
              "url": "@parameters('HPUKNewsSiteUrl')",
              "expiryColumn": "Expiry_x0020_Date"
            },
            {
              "key": "Other News",
              "url": "@parameters('OtherNewsSiteUrl')",
              "expiryColumn": "ExpiryDate"
            }
          ],
          "runAfter": {
            "Today_UK": [
              "Succeeded"
            ]
          }
        },
        "For_each_site": {
          "type": "Foreach",
          "foreach": "@outputs('Sites')",
          "actions": {
            "Get_expired_pages": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@items('For_each_site')?['url']",
                  "table": "Site Pages",
                  "$filter": "@{concat('PromotedState eq 2 and ', items('For_each_site')?['expiryColumn'], ' lt ''', outputs('Today_UK'), '''')}",
                  "$top": 5000
                }
              },
              "runAfter": {},
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 100000
                }
              }
            },
            "For_each_expired_page": {
              "type": "Foreach",
              "foreach": "@outputs('Get_expired_pages')?['body/value']",
              "actions": {
                "Read_file_state": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@items('For_each_site')?['url']",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File?$select=Level,CheckOutType",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Record_read_failed": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ': could not read the page state, so it was left alone')}"
                  },
                  "runAfter": {
                    "Read_file_state": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                },
                "Condition_checked_out": {
                  "type": "If",
                  "expression": {
                    "equals": [
                      "@body('Read_file_state')?['Level']",
                      255
                    ]
                  },
                  "actions": {
                    "Record_checked_out": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Failures",
                        "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ': checked out by someone, so it was left alone; check it in and the next run archives it')}"
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {
                      "Condition_left_hidden": {
                        "type": "If",
                        "description": "A news post that was published and later unpublished (by a person, or by C1 before 1.8.0.0). Left hidden unless ArchiveUnpublishedExpired is Yes.",
                        "expression": {
                          "and": [
                            {
                              "equals": [
                                "@body('Read_file_state')?['Level']",
                                2
                              ]
                            },
                            {
                              "not": {
                                "equals": [
                                  "@parameters('ArchiveUnpublishedExpired')",
                                  true
                                ]
                              }
                            }
                          ]
                        },
                        "actions": {
                          "Record_left_hidden": {
                            "type": "AppendToArrayVariable",
                            "inputs": {
                              "name": "LeftHidden",
                              "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                            },
                            "runAfter": {}
                          }
                        },
                        "else": {
                          "actions": {
                            "Condition_writes_enabled": {
                              "type": "If",
                              "expression": {
                                "equals": [
                                  "@parameters('ExpiryWritesEnabled')",
                                  true
                                ]
                              },
                              "actions": {
                                "Check_out": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "HttpRequest",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                    },
                                    "parameters": {
                                      "dataset": "@items('For_each_site')?['url']",
                                      "parameters/method": "POST",
                                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File/CheckOut()",
                                      "parameters/headers": {
                                        "Accept": "application/json;odata=nometadata",
                                        "Content-Type": "application/json;odata=nometadata"
                                      }
                                    }
                                  },
                                  "runAfter": {},
                                  "description": "Check the page out so its properties can be changed safely (a published page in a library with draft versions can't be updated in place)."
                                },
                                "Update_fields": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "HttpRequest",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                    },
                                    "parameters": {
                                      "dataset": "@items('For_each_site')?['url']",
                                      "parameters/method": "POST",
                                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/ValidateUpdateListItem",
                                      "parameters/headers": {
                                        "Accept": "application/json;odata=nometadata",
                                        "Content-Type": "application/json;odata=nometadata"
                                      },
                                      "parameters/body": {
                                        "formValues": [
                                          {
                                            "FieldName": "Status",
                                            "FieldValue": "Expired"
                                          },
                                          {
                                            "FieldName": "ShowinNews",
                                            "FieldValue": "0"
                                          },
                                          {
                                            "FieldName": "PromotedState",
                                            "FieldValue": "0"
                                          }
                                        ],
                                        "bNewDocumentUpdate": false
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Check_out": [
                                      "Succeeded"
                                    ]
                                  },
                                  "description": "Status Expired, Show in News No, and PromotedState 0: the page stops being a news post, so it leaves every news feed, hub news, Viva and the roundup."
                                },
                                "Condition_fields_ok": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@actions('Update_fields')?['status']",
                                          "Succeeded"
                                        ]
                                      },
                                      {
                                        "not": {
                                          "contains": [
                                            "@string(actions('Update_fields')?['outputs']?['body'])",
                                            "\"HasException\":true"
                                          ]
                                        }
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Check_in": {
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "host": {
                                          "connectionName": "shared_sharepointonline",
                                          "operationId": "HttpRequest",
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                        },
                                        "parameters": {
                                          "dataset": "@items('For_each_site')?['url']",
                                          "parameters/method": "POST",
                                          "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File/CheckIn(comment='ArchivedByC1',checkintype=1)",
                                          "parameters/headers": {
                                            "Accept": "application/json;odata=nometadata",
                                            "Content-Type": "application/json;odata=nometadata"
                                          }
                                        }
                                      },
                                      "runAfter": {},
                                      "description": "Major check-in: publishes the page again as an ordinary page, readable from the News archive."
                                    },
                                    "Undo_after_check_in_failed": {
                                      "type": "OpenApiConnection",
                                      "inputs": {
                                        "host": {
                                          "connectionName": "shared_sharepointonline",
                                          "operationId": "HttpRequest",
                                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                        },
                                        "parameters": {
                                          "dataset": "@items('For_each_site')?['url']",
                                          "parameters/method": "POST",
                                          "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File/UndoCheckOut()",
                                          "parameters/headers": {
                                            "Accept": "application/json;odata=nometadata",
                                            "Content-Type": "application/json;odata=nometadata"
                                          }
                                        }
                                      },
                                      "runAfter": {
                                        "Check_in": [
                                          "Failed",
                                          "TimedOut"
                                        ]
                                      }
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Undo_check_out": {
                                        "type": "OpenApiConnection",
                                        "inputs": {
                                          "host": {
                                            "connectionName": "shared_sharepointonline",
                                            "operationId": "HttpRequest",
                                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                          },
                                          "parameters": {
                                            "dataset": "@items('For_each_site')?['url']",
                                            "parameters/method": "POST",
                                            "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File/UndoCheckOut()",
                                            "parameters/headers": {
                                              "Accept": "application/json;odata=nometadata",
                                              "Content-Type": "application/json;odata=nometadata"
                                            }
                                          }
                                        },
                                        "runAfter": {},
                                        "description": "Leave the page as it was, not checked out."
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Update_fields": [
                                      "Succeeded",
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  }
                                },
                                "Read_back": {
                                  "type": "OpenApiConnection",
                                  "inputs": {
                                    "host": {
                                      "connectionName": "shared_sharepointonline",
                                      "operationId": "HttpRequest",
                                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                                    },
                                    "parameters": {
                                      "dataset": "@items('For_each_site')?['url']",
                                      "parameters/method": "GET",
                                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})?$select=Status,ShowinNews,PromotedState,File/Level&$expand=File",
                                      "parameters/headers": {
                                        "Accept": "application/json;odata=nometadata",
                                        "Content-Type": "application/json;odata=nometadata"
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Condition_fields_ok": [
                                      "Succeeded",
                                      "Failed",
                                      "TimedOut",
                                      "Skipped"
                                    ]
                                  }
                                },
                                "Condition_confirmed": {
                                  "type": "If",
                                  "expression": {
                                    "and": [
                                      {
                                        "equals": [
                                          "@actions('Read_back')?['status']",
                                          "Succeeded"
                                        ]
                                      },
                                      {
                                        "equals": [
                                          "@body('Read_back')?['File']?['Level']",
                                          1
                                        ]
                                      },
                                      {
                                        "equals": [
                                          "@body('Read_back')?['Status']",
                                          "Expired"
                                        ]
                                      },
                                      {
                                        "equals": [
                                          "@body('Read_back')?['PromotedState']",
                                          0
                                        ]
                                      }
                                    ]
                                  },
                                  "actions": {
                                    "Record_archived": {
                                      "type": "AppendToArrayVariable",
                                      "inputs": {
                                        "name": "Archived",
                                        "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                                      },
                                      "runAfter": {}
                                    }
                                  },
                                  "else": {
                                    "actions": {
                                      "Record_failure": {
                                        "type": "AppendToArrayVariable",
                                        "inputs": {
                                          "name": "Failures",
                                          "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ' - read-back: level ', coalesce(string(body('Read_back')?['File']?['Level']), 'unknown'), ', status ', coalesce(string(body('Read_back')?['Status']), 'unknown'), ', promoted state ', coalesce(string(body('Read_back')?['PromotedState']), 'unknown'), '. Check out: ', concat(coalesce(actions('Check_out')?['status'], 'not run'), ' ', take(string(coalesce(actions('Check_out')?['outputs']?['body']?['error']?['innerError']?['message'], actions('Check_out')?['outputs']?['body']?['error']?['message'], actions('Check_out')?['outputs']?['body'], '')), 500)), '. Update: ', concat(coalesce(actions('Update_fields')?['status'], 'not run'), ' ', take(string(coalesce(actions('Update_fields')?['outputs']?['body']?['error']?['innerError']?['message'], actions('Update_fields')?['outputs']?['body']?['error']?['message'], actions('Update_fields')?['outputs']?['body'], '')), 500)), '. Check in: ', concat(coalesce(actions('Check_in')?['status'], 'not run'), ' ', take(string(coalesce(actions('Check_in')?['outputs']?['body']?['error']?['innerError']?['message'], actions('Check_in')?['outputs']?['body']?['error']?['message'], actions('Check_in')?['outputs']?['body'], '')), 500)))}"
                                        },
                                        "runAfter": {}
                                      }
                                    }
                                  },
                                  "runAfter": {
                                    "Read_back": [
                                      "Succeeded",
                                      "Failed",
                                      "TimedOut"
                                    ]
                                  }
                                }
                              },
                              "else": {
                                "actions": {
                                  "Record_would_archive": {
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                      "name": "WouldArchive",
                                      "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                                    },
                                    "runAfter": {}
                                  }
                                }
                              },
                              "runAfter": {}
                            }
                          }
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "runAfter": {
                    "Read_file_state": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Get_expired_pages": [
                  "Succeeded"
                ]
              }
            },
            "Record_site_read_failed": {
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "Failures",
                "value": "@{concat(items('For_each_site')?['key'], ': could not list expired pages, so none were checked on this site')}"
              },
              "runAfter": {
                "Get_expired_pages": [
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {
            "Sites": [
              "Succeeded"
            ]
          }
        },
        "Condition_any_failures": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(variables('Failures'))",
              0
            ]
          },
          "actions": {
            "Alert_support": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('SupportOwnerEmail')",
                  "emailMessage/Subject": "News expiry: some expired posts are still in the news feeds",
                  "emailMessage/Body": "<p>These news posts are past their Expiry Date but couldn't be confirmed as archived. They may still show in the news feeds:</p><p>@{join(variables('Failures'), '<br>')}</p><p>Each line gives the page's state on read-back and SharePoint's response to each step. <b>Additions to this Web site have been blocked</b> means the site is locked or full; <b>checked out</b> means an editor has the page (see Troubleshooting in the news README and C1-WALKTHROUGH.md). Fix the cause, then re-run the flow: pages already archived are skipped.</p>",
                  "emailMessage/Importance": "High"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "For_each_site": [
              "Succeeded",
              "Failed"
            ]
          }
        },
        "Condition_dry_run": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(variables('WouldArchive'))",
              0
            ]
          },
          "actions": {
            "Report_dry_run": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('SupportOwnerEmail')",
                  "emailMessage/Subject": "News expiry (dry run): posts that would be archived",
                  "emailMessage/Body": "<p>Expiry writes are off (ExpiryWritesEnabled = No), so nothing was changed. With writes on, these posts would be set to Status Expired and Show in News No, turned from news posts into ordinary pages (so they leave every news feed and the roundup) and kept published in the News archive:</p><p>@{join(variables('WouldArchive'), '<br>')}</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Condition_any_failures": [
              "Succeeded"
            ]
          }
        },
        "Condition_report_requested": {
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@trim(coalesce(parameters('ExpiryReportEmail'), ''))",
                ""
              ]
            }
          },
          "actions": {
            "Send_expiry_report": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('ExpiryReportEmail')",
                  "emailMessage/Subject": "@{concat('News expiry report: ', string(length(variables('Archived'))), ' archived, ', string(length(variables('Failures'))), ' failed, ', string(length(variables('WouldArchive'))), ' in dry run')}",
                  "emailMessage/Body": "<p>News expiry run for @{outputs('Today_UK')} (UK date). Expiry writes are @{if(equals(parameters('ExpiryWritesEnabled'), true), 'on', 'off (dry run: nothing was changed)')}.</p><p><b>Archived</b> (Status Expired, Show in News No, no longer a news post, still published in the News archive; confirmed by read-back):<br>@{if(empty(variables('Archived')), 'None', join(variables('Archived'), '<br>'))}</p><p><b>Could not be confirmed</b>:<br>@{if(empty(variables('Failures')), 'None', join(variables('Failures'), '<br>'))}</p><p><b>Would be archived if writes were on</b>:<br>@{if(empty(variables('WouldArchive')), 'None', join(variables('WouldArchive'), '<br>'))}</p><p><b>Unpublished earlier and left hidden</b> (set ArchiveUnpublishedExpired to Yes for one run to move them to the archive, or republish one by hand):<br>@{if(empty(variables('LeftHidden')), 'None', join(variables('LeftHidden'), '<br>'))}</p><p>Pages and attachments are never deleted. Archived posts stay readable for their 7-year retention; to remove one completely, unpublish it by hand.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Condition_dry_run": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Initialize_WouldArchive": [
          "Succeeded"
        ]
      }
    },
    "Catch_run_failed": {
      "type": "Scope",
      "description": "Run-level failure alert: any error in Scope_Main that no step handled.",
      "actions": {
        "Select_failed_steps": {
          "type": "Select",
          "inputs": {
            "from": "@result('Scope_Main')",
            "select": "@concat('<li><b>', item()?['name'], '</b>: ', item()?['status'], ' ', coalesce(item()?['error']?['code'], item()?['outputs']?['statusCode'], ''), ' ', coalesce(item()?['error']?['message'], ''), '</li>')"
          },
          "runAfter": {}
        },
        "Alert_run_failed": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
              "emailMessage/To": "@parameters('SupportOwnerEmail')",
              "emailMessage/Subject": "@{concat('Flow failed: ', workflow()?['tags']?['flowDisplayName'])}",
              "emailMessage/Body": "<p>The flow <b>@{workflow()?['tags']?['flowDisplayName']}</b> stopped with an error it did not handle, so some of its work may not have been done. Nothing has been retried.</p><p>Run: <a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">@{workflow()?['run']?['name']}</a> (started @{workflow()?['run']?['startTime']})</p><ul>@{join(body('Select_failed_steps'), '')}</ul><p>Open the run, find the failed step and its raw output, fix the cause, then resubmit the run or deal with the items by hand. Check for partial changes first (see Stopping and recovery in the deployment guide).</p>",
              "emailMessage/Importance": "High"
            }
          },
          "runAfter": {
            "Select_failed_steps": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Scope_Main": [
          "Failed",
          "TimedOut"
        ]
      }
    }
  }
}
