{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "displayName": "C1 Expire news posts",
  "description": "Runs daily at 06:00 UK time. On HPUK News and Other News, finds news posts whose Expiry Date is before today (the Expiry Date is the last day a notice is current). For each one it removes the page from news (PromotedState 0) and sets Status to Expired and Show in News to No in one ValidateUpdateListItem call (no new version, no draft). The page stays published, so links in old emails and Teams posts keep working, but it drops out of every news feed once search catches up. Success is confirmed by reading the page back (not news, Expired); anything else is reported with SharePoint's response, and the run carries on with the next page. Pages are never unpublished or deleted. Checked-out pages are reported, not forced. While ExpiryWritesEnabled is No it changes nothing and emails the posts it would remove from news. ExpiryReportEmail, if set, gets a report of every run.",
  "connectionReferences": {
    "shared_sharepointonline": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
    },
    "shared_office365": {
      "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
    }
  },
  "parameters": {
    "$connections": {
      "type": "Object",
      "defaultValue": {}
    },
    "$authentication": {
      "type": "SecureObject",
      "defaultValue": {}
    },
    "HPUKNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{hpuk-news}"
    },
    "OtherNewsSiteUrl": {
      "type": "String",
      "defaultValue": "https://{tenant}.sharepoint.com/sites/{other-news}"
    },
    "CommsSenderMailbox": {
      "type": "String",
      "defaultValue": "{communications-shared-mailbox}@{domain}"
    },
    "CommsTeamEmail": {
      "type": "String",
      "defaultValue": "{communications-team}@{domain}"
    },
    "SupportOwnerEmail": {
      "type": "String",
      "defaultValue": "{news-support-owner}@{domain}"
    },
    "UrgentPublisherEmails": {
      "type": "String",
      "defaultValue": "{urgent-publisher-1}@{domain};{urgent-publisher-2}@{domain}"
    },
    "DispatchEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryWritesEnabled": {
      "type": "Bool",
      "defaultValue": false
    },
    "ExpiryReportEmail": {
      "type": "String",
      "defaultValue": ""
    }
  },
  "triggers": {
    "Daily_0600_UK": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "GMT Standard Time",
        "schedule": {
          "hours": [
            6
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Initialize_Failures": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Failures",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_Removed": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "Removed",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Failures": [
          "Succeeded"
        ]
      }
    },
    "Initialize_StillDraft": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "StillDraft",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Removed": [
          "Succeeded"
        ]
      }
    },
    "Initialize_WouldRemove": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "WouldRemove",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_StillDraft": [
          "Succeeded"
        ]
      }
    },
    "Scope_Main": {
      "type": "Scope",
      "actions": {
        "Today_UK": {
          "type": "Compose",
          "inputs": "@convertTimeZone(utcNow(), 'UTC', 'GMT Standard Time', 'yyyy-MM-dd')",
          "runAfter": {}
        },
        "Sites": {
          "type": "Compose",
          "inputs": [
            {
              "key": "HPUK News",
              "url": "@parameters('HPUKNewsSiteUrl')",
              "expiryColumn": "Expiry_x0020_Date"
            },
            {
              "key": "Other News",
              "url": "@parameters('OtherNewsSiteUrl')",
              "expiryColumn": "ExpiryDate"
            }
          ],
          "runAfter": {
            "Today_UK": [
              "Succeeded"
            ]
          }
        },
        "For_each_site": {
          "type": "Foreach",
          "foreach": "@outputs('Sites')",
          "actions": {
            "Get_expired_pages": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "GetItems",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "@items('For_each_site')?['url']",
                  "table": "Site Pages",
                  "$filter": "@{concat('PromotedState eq 2 and ', items('For_each_site')?['expiryColumn'], ' lt ''', outputs('Today_UK'), '''')}",
                  "$top": 5000
                }
              },
              "runAfter": {},
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 100000
                }
              }
            },
            "For_each_expired_page": {
              "type": "Foreach",
              "foreach": "@outputs('Get_expired_pages')?['body/value']",
              "actions": {
                "Read_file_state": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "@items('For_each_site')?['url']",
                      "parameters/method": "GET",
                      "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/File?$select=Level,CheckOutType",
                      "parameters/headers": {
                        "Accept": "application/json;odata=nometadata",
                        "Content-Type": "application/json;odata=nometadata"
                      }
                    }
                  },
                  "runAfter": {}
                },
                "Condition_writes_enabled": {
                  "type": "If",
                  "runAfter": {
                    "Read_file_state": [
                      "Succeeded"
                    ]
                  },
                  "expression": {
                    "equals": [
                      "@parameters('ExpiryWritesEnabled')",
                      true
                    ]
                  },
                  "else": {
                    "actions": {
                      "Record_would_remove": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "WouldRemove",
                          "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                        },
                        "runAfter": {}
                      }
                    }
                  },
                  "actions": {
                    "Condition_checked_out": {
                      "type": "If",
                      "runAfter": {},
                      "expression": {
                        "equals": [
                          "@body('Read_file_state')?['Level']",
                          255
                        ]
                      },
                      "actions": {
                        "Record_checked_out": {
                          "type": "AppendToArrayVariable",
                          "inputs": {
                            "name": "Failures",
                            "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ' - checked out to someone: publish or discard their draft, then re-run')}"
                          },
                          "runAfter": {}
                        }
                      },
                      "else": {
                        "actions": {
                          "Expire_page": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_sharepointonline",
                                "operationId": "HttpRequest",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@items('For_each_site')?['url']",
                                "parameters/method": "POST",
                                "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})/ValidateUpdateListItem",
                                "parameters/headers": {
                                  "Accept": "application/json;odata=nometadata",
                                  "Content-Type": "application/json;odata=nometadata"
                                },
                                "parameters/body": {
                                  "formValues": [
                                    {
                                      "FieldName": "Status",
                                      "FieldValue": "Expired"
                                    },
                                    {
                                      "FieldName": "ShowinNews",
                                      "FieldValue": "0"
                                    },
                                    {
                                      "FieldName": "PromotedState",
                                      "FieldValue": "0"
                                    }
                                  ],
                                  "bNewDocumentUpdate": true
                                }
                              }
                            },
                            "runAfter": {}
                          },
                          "Read_back": {
                            "type": "OpenApiConnection",
                            "inputs": {
                              "host": {
                                "connectionName": "shared_sharepointonline",
                                "operationId": "HttpRequest",
                                "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                              },
                              "parameters": {
                                "dataset": "@items('For_each_site')?['url']",
                                "parameters/method": "GET",
                                "parameters/uri": "_api/web/lists/GetByTitle('Site Pages')/items(@{items('For_each_expired_page')?['ID']})?$select=Status,ShowinNews,PromotedState,File/Level&$expand=File",
                                "parameters/headers": {
                                  "Accept": "application/json;odata=nometadata",
                                  "Content-Type": "application/json;odata=nometadata"
                                }
                              }
                            },
                            "runAfter": {
                              "Expire_page": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                              ]
                            }
                          },
                          "Condition_confirmed": {
                            "type": "If",
                            "runAfter": {
                              "Read_back": [
                                "Succeeded",
                                "Failed",
                                "TimedOut"
                              ]
                            },
                            "expression": {
                              "and": [
                                {
                                  "equals": [
                                    "@actions('Read_back')?['status']",
                                    "Succeeded"
                                  ]
                                },
                                {
                                  "equals": [
                                    "@int(coalesce(body('Read_back')?['PromotedState'], -1))",
                                    0
                                  ]
                                },
                                {
                                  "equals": [
                                    "@body('Read_back')?['Status']",
                                    "Expired"
                                  ]
                                }
                              ]
                            },
                            "actions": {
                              "Record_removed": {
                                "type": "AppendToArrayVariable",
                                "inputs": {
                                  "name": "Removed",
                                  "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                                },
                                "runAfter": {}
                              },
                              "Condition_still_draft": {
                                "type": "If",
                                "runAfter": {
                                  "Record_removed": [
                                    "Succeeded"
                                  ]
                                },
                                "expression": {
                                  "equals": [
                                    "@body('Read_back')?['File']?['Level']",
                                    2
                                  ]
                                },
                                "actions": {
                                  "Record_still_draft": {
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                      "name": "StillDraft",
                                      "value": "@{concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title'])}"
                                    },
                                    "runAfter": {}
                                  }
                                }
                              }
                            },
                            "else": {
                              "actions": {
                                "Record_failure": {
                                  "type": "AppendToArrayVariable",
                                  "inputs": {
                                    "name": "Failures",
                                    "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ' - read-back: news flag ', coalesce(string(body('Read_back')?['PromotedState']), 'unknown'), ', status ', coalesce(string(body('Read_back')?['Status']), 'unknown'), '. Update: ', coalesce(actions('Expire_page')?['status'], 'unknown'), ' ', take(string(coalesce(actions('Expire_page')?['outputs']?['body'], '')), 300))}"
                                  },
                                  "runAfter": {}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Record_read_failed": {
                  "type": "AppendToArrayVariable",
                  "inputs": {
                    "name": "Failures",
                    "value": "@{concat(concat(items('For_each_site')?['key'], ': ', items('For_each_expired_page')?['Title']), ' - could not read the page state: ', take(string(coalesce(actions('Read_file_state')?['outputs']?['body'], '')), 300))}"
                  },
                  "runAfter": {
                    "Read_file_state": [
                      "Failed",
                      "TimedOut"
                    ]
                  }
                }
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              },
              "runAfter": {
                "Get_expired_pages": [
                  "Succeeded"
                ]
              }
            },
            "Record_site_read_failed": {
              "type": "AppendToArrayVariable",
              "inputs": {
                "name": "Failures",
                "value": "@{concat(items('For_each_site')?['key'], ': could not list expired pages, so none were checked on this site')}"
              },
              "runAfter": {
                "Get_expired_pages": [
                  "Failed",
                  "TimedOut"
                ]
              }
            }
          },
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 1
            }
          },
          "runAfter": {
            "Sites": [
              "Succeeded"
            ]
          }
        },
        "Condition_any_failures": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(variables('Failures'))",
              0
            ]
          },
          "actions": {
            "Alert_support": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('SupportOwnerEmail')",
                  "emailMessage/Subject": "News expiry: some expired posts are still in the news",
                  "emailMessage/Body": "<p>These news posts are past their Expiry Date but couldn't be confirmed as removed from news. Readers may still see them in news feeds:</p><p>@{join(variables('Failures'), '<br>')}</p><p>Each line gives the page's state on read-back and the response from SharePoint. A message saying <b>Additions to this Web site have been blocked</b> means the site is locked or full (see runbooks/Site-Write-Failure.md in the news solution). Fix the cause, then re-run the flow: pages already removed from news are not picked up again.</p>",
                  "emailMessage/Importance": "High"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "For_each_site": [
              "Succeeded",
              "Failed"
            ]
          }
        },
        "Condition_dry_run": {
          "type": "If",
          "expression": {
            "greater": [
              "@length(variables('WouldRemove'))",
              0
            ]
          },
          "actions": {
            "Report_dry_run": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('SupportOwnerEmail')",
                  "emailMessage/Subject": "News expiry (dry run): posts that would be removed from news",
                  "emailMessage/Body": "<p>Expiry writes are off (ExpiryWritesEnabled = No), so nothing was changed. With writes on, these posts would be removed from news and set to Status Expired and Show in News No. They stay published, so existing links keep working:</p><p>@{join(variables('WouldRemove'), '<br>')}</p><p>Before switching writes on, check on a test post that it drops out of the news web parts and stays openable from its link.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Condition_any_failures": [
              "Succeeded"
            ]
          }
        },
        "Condition_report_requested": {
          "type": "If",
          "expression": {
            "not": {
              "equals": [
                "@trim(coalesce(parameters('ExpiryReportEmail'), ''))",
                ""
              ]
            }
          },
          "actions": {
            "Send_expiry_report": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SharedMailboxSendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
                  "emailMessage/To": "@parameters('ExpiryReportEmail')",
                  "emailMessage/Subject": "@{concat('News expiry report: ', string(length(variables('Removed'))), ' removed from news, ', string(length(variables('Failures'))), ' failed, ', string(length(variables('WouldRemove'))), ' in dry run')}",
                  "emailMessage/Body": "<p>News expiry run for @{outputs('Today_UK')} (UK date). Expiry writes are @{if(equals(parameters('ExpiryWritesEnabled'), true), 'on', 'off (dry run: nothing was changed)')}.</p><p><b>Removed from news</b> (no longer a news post, Status Expired, Show in News No, still published, confirmed by read-back):<br>@{if(empty(variables('Removed')), 'None', join(variables('Removed'), '<br>'))}</p><p><b>Could not be confirmed</b>:<br>@{if(empty(variables('Failures')), 'None', join(variables('Failures'), '<br>'))}</p><p><b>Would be removed from news if writes were on</b>:<br>@{if(empty(variables('WouldRemove')), 'None', join(variables('WouldRemove'), '<br>'))}</p><p><b>Still a draft</b> (unpublished by an earlier version of this flow; now removed from news too, so republishing it won't put it back in the news):<br>@{if(empty(variables('StillDraft')), 'None', join(variables('StillDraft'), '<br>'))}</p><p>Pages are never unpublished or deleted. A removed post stays in Site Pages for its 7-year retention and can be found by search or its link.</p>",
                  "emailMessage/Importance": "Normal"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Condition_dry_run": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Initialize_WouldRemove": [
          "Succeeded"
        ]
      }
    },
    "Catch_run_failed": {
      "type": "Scope",
      "description": "Run-level failure alert: any error in Scope_Main that no step handled.",
      "actions": {
        "Select_failed_steps": {
          "type": "Select",
          "inputs": {
            "from": "@result('Scope_Main')",
            "select": "@concat('<li><b>', item()?['name'], '</b>: ', item()?['status'], ' ', coalesce(item()?['error']?['code'], item()?['outputs']?['statusCode'], ''), ' ', coalesce(item()?['error']?['message'], ''), '</li>')"
          },
          "runAfter": {}
        },
        "Alert_run_failed": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SharedMailboxSendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/MailboxAddress": "@parameters('CommsSenderMailbox')",
              "emailMessage/To": "@parameters('SupportOwnerEmail')",
              "emailMessage/Subject": "@{concat('Flow failed: ', workflow()?['tags']?['flowDisplayName'])}",
              "emailMessage/Body": "<p>The flow <b>@{workflow()?['tags']?['flowDisplayName']}</b> stopped with an error it did not handle, so some of its work may not have been done. Nothing has been retried.</p><p>Run: <a href=\"@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}\">@{workflow()?['run']?['name']}</a> (started @{workflow()?['run']?['startTime']})</p><ul>@{join(body('Select_failed_steps'), '')}</ul><p>Open the run, find the failed step and its raw output, fix the cause, then resubmit the run or deal with the items by hand. Check for partial changes first (see Stopping and recovery in the deployment guide).</p>",
              "emailMessage/Importance": "High"
            }
          },
          "runAfter": {
            "Select_failed_steps": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Scope_Main": [
          "Failed",
          "TimedOut"
        ]
      }
    }
  }
}
