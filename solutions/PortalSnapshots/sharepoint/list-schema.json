{
  "$comment": "Lists the portal snapshot flows read. 'site' says which environment variable's site holds the list (asset: PortalAssetSiteUrl, board: PortalBoardSiteUrl, governance: PortalGovernanceSiteUrl). Lists marked 'existing' belong to another solution and are not created by provisioning/Provision-PortalSnapshots.ps1; only the columns the flows read are listed for them. tools/validate_flows.py checks every column the flows use against this file.",
  "lists": [
    {
      "listTitle": "Asset Register",
      "url": "Lists/AssetRegister",
      "template": "GenericList",
      "site": "asset",
      "listDescription": "One row per IT or operational asset. Flow P1 publishes it to the Asset Management portal. Title is the asset name.",
      "fields": [
        {
          "internalName": "AssetTag",
          "displayName": "Asset tag",
          "type": "Text",
          "required": true,
          "indexed": true,
          "notes": "e.g. HPUK-FXT-0101. Unique."
        },
        {
          "internalName": "Category",
          "displayName": "Category",
          "type": "Choice",
          "required": true,
          "choices": [
            "Hardware",
            "Mobile",
            "Network",
            "Port Equipment",
            "Software"
          ]
        },
        {
          "internalName": "PortLocation",
          "displayName": "Port location",
          "type": "Choice",
          "required": true,
          "choices": [
            "Felixstowe",
            "Harwich",
            "Thamesport",
            "Corporate"
          ]
        },
        {
          "internalName": "AssignedOwner",
          "displayName": "Assigned owner / custodian",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "LifecycleStatus",
          "displayName": "Lifecycle status",
          "type": "Choice",
          "required": true,
          "choices": [
            "In Stock",
            "Deployed",
            "Maintenance",
            "Pending Disposal",
            "Retired"
          ],
          "default": "In Stock"
        },
        {
          "internalName": "WarrantyExpiry",
          "displayName": "Warranty expiry",
          "type": "DateTime",
          "required": false,
          "format": "DateOnly"
        },
        {
          "internalName": "SerialNumber",
          "displayName": "Serial number",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "CostCentre",
          "displayName": "Cost centre",
          "type": "Text",
          "required": false
        },
        {
          "internalName": "SensitivityLabel",
          "displayName": "Sensitivity",
          "type": "Choice",
          "required": false,
          "choices": [
            "Public",
            "Internal",
            "Confidential",
            "Highly Confidential"
          ],
          "default": "Internal"
        }
      ]
    },
