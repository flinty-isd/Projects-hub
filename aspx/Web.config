<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Fill these in to connect to a live SharePoint site via Microsoft Graph.
         Leave any of these blank to run in demo mode with sample data.
         See README.md "ASP.NET Web Forms version" for Azure AD app registration steps.
         Do not commit real secrets here -- use IIS/Azure App Service application
         settings (or a Web.config transform excluded from source control) in production. -->
    <add key="SharePoint:TenantId" value="" />
    <add key="SharePoint:ClientId" value="" />
    <add key="SharePoint:ClientSecret" value="" />
    <add key="SharePoint:SiteHostname" value="" />
    <add key="SharePoint:SitePath" value="" />
    <add key="SharePoint:TasksList" value="Tasks" />
    <add key="SharePoint:RisksList" value="Risks" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <sessionState mode="InProc" timeout="60" />
  </system.web>
</configuration>
