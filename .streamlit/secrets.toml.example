# Copy this file to .streamlit/secrets.toml (which is gitignored) and fill
# in your Azure AD app registration + SharePoint site details.
# See README.md "Connecting to live SharePoint data" for setup steps.

[sharepoint]
tenant_id = "00000000-0000-0000-0000-000000000000"
client_id = "00000000-0000-0000-0000-000000000000"
client_secret = "your-client-secret"
site_hostname = "contoso.sharepoint.com"
site_path = "/sites/YourProjectSite"
tasks_list = "Tasks"
risks_list = "Risks"
