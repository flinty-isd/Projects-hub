# Copy this file to .streamlit/secrets.toml for local development
# (already gitignored — never commit real secrets), or paste the same
# keys into your host's secrets manager (e.g. Streamlit Community Cloud's
# "Secrets" settings for the app) when deploying.

TENANT_ID = "00000000-0000-0000-0000-000000000000"
CLIENT_ID = "00000000-0000-0000-0000-000000000000"
CLIENT_SECRET = "your-client-secret-value"
