<?xml version="1.0" encoding="utf-8"?>
<!--
  SharePoint Reporting Dashboard configuration.

  Data source: this app reads through Services.ISharePointDataService.
  Today "UseMockData" is true and DataServiceFactory always hands back
  MockSharePointDataService, so the dashboard runs with no SharePoint
  tenant at all. To point it at a real tenant:
    1. Implement ISharePointDataService against SharePoint CSOM or the
       PnP.Framework / PnP.Core libraries (add the NuGet package first).
    2. Set UseMockData to false below and fill in the SharePoint.* keys.
    3. Wire the new implementation into DataServiceFactory.GetService().
-->
<configuration>
  <appSettings>
    <add key="UseMockData" value="true" />
    <add key="SharePoint.TenantUrl" value="https://contoso.sharepoint.com" />
    <add key="SharePoint.ClientId" value="" />
    <add key="SharePoint.ClientSecret" value="" />
    <add key="SharePoint.AuthMode" value="AppOnly" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="Predictable" />
    <customErrors mode="RemoteOnly" />
    <authentication mode="None" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
