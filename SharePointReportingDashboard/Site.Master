<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="SharePointReportingDashboard.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">HPUK SharePoint Project Control Centre</asp:ContentPlaceHolder></title>
    <link rel="stylesheet" type="text/css" href="Content/Site.css" />
</head>
<body>
    <form id="mainForm" runat="server">
        <header class="app-header">
            <div class="app-header-inner">
                <span class="app-title">HPUK SharePoint Project Control Centre</span>
                <span class="app-subtitle">Illustrative data &mdash; not the live SharePoint tenant</span>
            </div>
            <nav class="app-nav">
                <a runat="server" id="navOverview" href="~/Default.aspx">Programme Control Centre</a>
                <a runat="server" id="navMigration" href="~/Migration.aspx">Migration</a>
                <a runat="server" id="navPages" href="~/Pages.aspx">People &amp; Pages</a>
                <a runat="server" id="navGovernance" href="~/Governance.aspx">Governance</a>
            </nav>
        </header>

        <main class="app-main">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>

        <footer class="app-footer">
            <span>Data source: Mock / illustrative (see Web.config <code>UseMockData</code>) &mdash; not connected to the live HPUK tenant</span>
            <span id="footerTimestamp" runat="server"></span>
        </footer>
    </form>
</body>
</html>
