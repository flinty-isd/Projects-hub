{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/column-formatting.schema.json",
  "elmType": "div",
  "txtContent": "@currentField",
  "style": {
    "display": "inline-block",
    "padding": "2px 10px",
    "border-radius": "12px",
    "font-size": "12px",
    "font-weight": "600",
    "white-space": "nowrap",
    "color": "=if(@currentField == 'Active','#004578', if(@currentField == 'Pending','#8a6116', if(@currentField == 'Expired','#605e5c', '#605e5c')))",
    "background-color": "=if(@currentField == 'Active','#deecf9', if(@currentField == 'Pending','#fff4ce', if(@currentField == 'Expired','#f3f2f1', '#f3f2f1')))"
  }
}
