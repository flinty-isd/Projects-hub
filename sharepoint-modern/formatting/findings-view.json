{
  "$schema": "https://developer.microsoft.com/json-schemas/sp/v2/row-formatting.schema.json",
  "additionalRowClass": "=if([$DueDate] != '' && Number([$DueDate]) < Number(@now) && [$Status] != 'Closed', 'sp-field-severity--severeWarning', if([$Severity] == 'Critical' && [$Status] != 'Closed', 'sp-field-severity--blocked', ''))"
}
